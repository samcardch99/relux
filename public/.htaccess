# relux-construction.com is the only public address: www and the old test
# subdomain (test.relux-construction.com, also reachable as /test/) redirect
# to it, keeping the path.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} ^(www|test)\.relux-construction\.com$ [NC]
  RewriteRule ^(.*)$ https://relux-construction.com/$1 [R=301,L]

  # Matched on the full URI: the test/ folder carries its own copy of this
  # file, which is the one that runs for /test/ paths
  RewriteCond %{HTTP_HOST} ^relux-construction\.com$ [NC]
  RewriteCond %{REQUEST_URI} ^/test(?:/(.*))?$
  RewriteRule ^ https://relux-construction.com/%1 [R=301,L]
</IfModule>
