---
/** Return arrow, pointing down-left — the mirror of ArrowUpRight. */
interface Props { size?: number }
const { size = 15 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d="M17 7 7 17"></path>
  <path d="M15 17H7V9"></path>
</svg>
