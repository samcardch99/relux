---
/** Outbound / call-to-action arrow, pointing up-right. */
interface Props { size?: number }
const { size = 15 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d="M7 17 17 7"></path>
  <path d="M9 7h8v8"></path>
</svg>
