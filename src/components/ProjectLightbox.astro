---
/**
 * PROJECT LIGHTBOX — full-screen viewer for the photos in a project detail.
 *
 * Ported from the Borsoga Studio site (Swiper 12 for the carousel, GSAP for
 * the motion). On open, a single fixed "morph" layer is placed over the
 * clicked photo — same size, same crop — and animated to its fitted
 * full-screen rect while its clip opens up, so the photo grows and un-crops
 * out of the page. On close it travels back into whichever photo is on screen.
 *
 * Unlike Borsoga, the detail view here is drawn in the browser and changes
 * project and language without a reload, so the slides are built when the
 * viewer opens, from the photos site.ts numbered with `data-lb-index`
 * (see tagGallery). The detail view, not the page, is what scrolls.
 */
import { COPY } from "../data/copy";

const en = COPY.en;
---

<div class="lb" id="project-lightbox" role="dialog" aria-modal="true" aria-label={en.lbGallery} tabindex="-1">
  <!-- Opaque backdrop. Fades in behind the travelling photo, out ahead of it. -->
  <div class="lb__backdrop"></div>

  <!-- Carousel. Its box IS the stage: every photo is fitted into this rect,
       so the morph target and the rendered slide land on the same pixels. -->
  <div class="swiper lb__swiper">
    <div class="swiper-wrapper"></div>
  </div>

  <!-- Morph layer — the element that travels between the page and the stage. -->
  <div class="lb__morph" aria-hidden="true">
    <img class="lb__morph-img" alt="" decoding="async" draggable="false" />
  </div>

  <div class="lb__ui">
    <div class="lb__bar lb__bar--top">
      <p class="lb__counter">
        <span id="lb-counter-index">01</span>
        <span class="lb__counter-sep">/</span>
        <span class="lb__counter-total" id="lb-counter-total">01</span>
      </p>
      <button class="lb__close" type="button" aria-label={en.lbClose}>
        <span class="lb__close-label" data-i18n="lbClose">{en.lbClose}</span>
        <span class="lb__close-x" aria-hidden="true"></span>
      </button>
    </div>

    <button class="lb__nav lb__nav--prev" type="button" aria-label={en.lbPrev}>
      <span class="lb__nav-arrow" aria-hidden="true"></span>
    </button>
    <button class="lb__nav lb__nav--next" type="button" aria-label={en.lbNext}>
      <span class="lb__nav-arrow" aria-hidden="true"></span>
    </button>

    <div class="lb__bar lb__bar--bottom">
      <p class="lb__caption">
        <span class="lb__title" id="lb-title"></span>
        <span class="lb__text" id="lb-caption"></span>
      </p>
      <p class="lb__hint">
        <span class="lb__hint--fine" data-i18n="lbHintFine">{en.lbHintFine}</span>
        <span class="lb__hint--coarse" data-i18n="lbHintCoarse">{en.lbHintCoarse}</span>
      </p>
    </div>

    <div class="lb__progress" aria-hidden="true">
      <div class="lb__progress-bg"></div>
      <div class="lb__progress-fill"></div>
    </div>
  </div>
</div>

<style>
  /* ── Shell ─────────────────────────────────────────────────────────────
     Stage insets double as the carousel's layout AND the geometry the morph
     fits into — they must stay in sync, hence the shared vars. */
  .lb {
    --lb-x: 56px;
    --lb-top: 88px;
    --lb-bottom: 100px;

    position: fixed;
    inset: 0;
    /* Over the views and the navbar, under the cursor dot (9999) */
    z-index: 9990;
    display: none;
    /* The views underneath already hold the page still; refusing the
       gesture keeps a swipe or pinch here from reaching them. */
    touch-action: none;
    overscroll-behavior: contain;
  }
  .lb.is-open {
    display: block;
  }
  .lb:focus {
    outline: none;
  }
  .lb__close:focus-visible,
  .lb__nav:focus-visible {
    outline: 1px solid rgb(239 226 196 / 0.7);
    outline-offset: 6px;
  }

  .lb__backdrop {
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    opacity: 0;
  }

  /* ── Swiper layout ───────────────────────────────────────────────────
     The few rules a one-per-view horizontal slider needs, kept here instead
     of importing swiper/css. */
  :global(.lb__swiper.swiper) {
    position: relative;
    overflow: hidden;
    list-style: none;
    padding: 0;
    z-index: 1;
    display: block;
  }
  :global(.lb__swiper .swiper-wrapper) {
    position: relative;
    width: 100%;
    height: 100%;
    z-index: 1;
    display: flex;
    box-sizing: content-box;
    transition-property: transform;
  }
  :global(.lb__swiper .swiper-slide) {
    flex-shrink: 0;
    width: 100%;
    height: 100%;
    position: relative;
    transition-property: transform;
  }
  :global(.lb__swiper.swiper-backface-hidden .swiper-slide) {
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  /* ── Stage / carousel ── */
  .lb__swiper {
    position: absolute;
    top: var(--lb-top);
    right: var(--lb-x);
    bottom: var(--lb-bottom);
    left: var(--lb-x);
    opacity: 0;
  }

  /* Slides are built at runtime, so these rules are global. */
  .lb :global(.lb__slide) {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    touch-action: none;
  }
  .lb :global(.lb__frame) {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .lb :global(.lb__slide img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
    transform-origin: center center;
  }

  /* ── Morph layer ── */
  .lb__morph {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 20;
    transform-origin: 0 0;
    will-change: transform;
    backface-visibility: hidden;
    pointer-events: none;
    display: none;
  }
  .lb__morph.is-active {
    display: block;
  }
  .lb__morph-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* ── Chrome ────────────────────────────────────────────────────────────
     Click-through except for the controls, so a click on the empty area
     around the photo still reaches the stage (where it closes the viewer). */
  .lb__ui {
    position: absolute;
    inset: 0;
    z-index: 10;
    pointer-events: none;
    opacity: 0;
  }
  .lb__close,
  .lb__nav {
    pointer-events: auto;
  }

  .lb__bar {
    position: absolute;
    left: var(--lb-x);
    right: var(--lb-x);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 32px;
  }
  .lb__bar--top {
    top: 30px;
  }
  .lb__bar--bottom {
    bottom: 34px;
  }

  .lb__counter,
  .lb__hint,
  .lb__close,
  .lb__title {
    margin: 0;
    font-size: var(--fs-label);
    font-weight: 400;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .lb__counter {
    color: var(--color-cream);
    font-variant-numeric: tabular-nums;
  }
  .lb__counter-sep {
    margin: 0 0.5em;
    opacity: 0.4;
  }
  .lb__counter-total {
    opacity: 0.4;
  }

  .lb__caption {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0;
    min-width: 0;
  }
  .lb__title {
    color: var(--color-stone);
  }
  .lb__text {
    font-size: var(--fs-xs);
    font-weight: 300;
    color: rgb(239 226 196 / 0.6);
  }
  .lb__hint {
    flex: none;
    color: rgb(239 226 196 / 0.3);
    text-align: right;
  }
  .lb__hint--coarse {
    display: none;
  }
  @media (pointer: coarse) {
    .lb__hint--fine {
      display: none;
    }
    .lb__hint--coarse {
      display: inline;
    }
  }

  /* Close — label + a 1px × drawn in CSS */
  .lb__close {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: none;
    border: 0;
    padding: 10px 0;
    color: var(--color-cream);
    transition: opacity 0.25s ease;
  }
  .lb__close:hover {
    opacity: 0.55;
  }
  .lb__close-x {
    position: relative;
    width: 16px;
    height: 16px;
    flex: none;
  }
  .lb__close-x::before,
  .lb__close-x::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
  }
  .lb__close-x::before {
    transform: rotate(45deg);
  }
  .lb__close-x::after {
    transform: rotate(-45deg);
  }

  /* Prev / next — hairline chevrons, pointer devices only */
  .lb__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 56px;
    height: 56px;
    display: none;
    align-items: center;
    justify-content: center;
    background: none;
    border: 0;
    padding: 0;
    color: var(--color-cream);
    opacity: 0.55;
    transition: opacity 0.25s ease;
  }
  .lb__nav:hover {
    opacity: 1;
  }
  .lb__nav:disabled {
    opacity: 0.12;
  }
  .lb__nav--prev {
    left: 0;
  }
  .lb__nav--next {
    right: 0;
  }
  @media (pointer: fine) {
    .lb__nav {
      display: flex;
    }
  }
  /* Zoomed in, the arrows would fight the pan gesture */
  .lb.is-zoomed .lb__nav {
    opacity: 0;
    pointer-events: none;
  }

  .lb__nav-arrow {
    width: 16px;
    height: 16px;
    border-left: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
  }
  .lb__nav--prev .lb__nav-arrow {
    transform: rotate(45deg);
    margin-left: 6px;
  }
  .lb__nav--next .lb__nav-arrow {
    transform: rotate(-135deg);
    margin-right: 6px;
  }

  /* Progress rule — 1px fill from the left */
  .lb__progress {
    position: absolute;
    left: var(--lb-x);
    right: var(--lb-x);
    bottom: 16px;
    height: 1px;
  }
  .lb__progress-bg {
    position: absolute;
    inset: 0;
    background: rgb(239 226 196 / 0.15);
  }
  .lb__progress-fill {
    position: absolute;
    inset: 0;
    background: var(--color-cream);
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* ── Phones ── */
  @media (max-width: 720px) {
    .lb {
      --lb-x: 16px;
      --lb-top: 64px;
      --lb-bottom: 104px;
    }
    .lb__bar--top {
      top: 14px;
    }
    .lb__bar--bottom {
      bottom: 30px;
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    .lb__hint {
      text-align: left;
    }
    .lb__close {
      padding: 12px 0 12px 12px;
      margin-right: -4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lb__morph {
      display: none !important;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  // Swiper's layout CSS lives in this component's <style> block.
  import Swiper from "swiper";
  import { COPY, type Lang } from "../data/copy";

  type Rect = { left: number; top: number; width: number; height: number };
  type Inset = { t: number; r: number; b: number; l: number };
  type Slide = { src: string; caption: string };

  /** Shorter and with less tail on touch, where the photo travels less. */
  const isCoarse = () => window.matchMedia("(pointer: coarse)").matches;
  const openDuration = () => (isCoarse() ? 0.42 : 0.9);
  const openEase = () => (isCoarse() ? "power3.out" : "expo.out");
  const closeDuration = () => (isCoarse() ? 0.34 : 0.68);
  const closeEase = () => (isCoarse() ? "power2.inOut" : "power3.inOut");
  const reduceMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const root = document.getElementById("project-lightbox") as HTMLElement;
  const view = document.getElementById("view-detail") as HTMLElement;
  const morph = root.querySelector(".lb__morph") as HTMLElement;
  const morphImg = root.querySelector(".lb__morph-img") as HTMLImageElement;
  const swiperEl = root.querySelector(".lb__swiper") as HTMLElement;
  const wrapper = root.querySelector(".swiper-wrapper") as HTMLElement;
  const backdrop = root.querySelector(".lb__backdrop") as HTMLElement;
  const ui = root.querySelector(".lb__ui") as HTMLElement;
  const progressFill = root.querySelector(".lb__progress-fill") as HTMLElement;
  const counterIndex = document.getElementById("lb-counter-index") as HTMLElement;
  const counterTotal = document.getElementById("lb-counter-total") as HTMLElement;
  const titleEl = document.getElementById("lb-title") as HTMLElement;
  const captionEl = document.getElementById("lb-caption") as HTMLElement;
  const prevBtn = root.querySelector(".lb__nav--prev") as HTMLButtonElement;
  const nextBtn = root.querySelector(".lb__nav--next") as HTMLButtonElement;
  const closeBtn = root.querySelector(".lb__close") as HTMLButtonElement;

  let swiper: Swiper | null = null;
  let slides: Slide[] = [];
  let builtFor = "";
  let isOpen = false;
  let isAnimating = false;
  let lastTrigger: HTMLElement | null = null;
  /** Photo faded out on the page while the morph stands in for it. */
  let hiddenThumb: HTMLElement | null = null;
  let tl: gsap.core.Timeline | null = null;

  const pad = (n: number) => String(n).padStart(2, "0");

  // ───────────────────────────────────────────────────────────────────────
  // SLIDES — read from the photos the detail view has on screen.
  // ───────────────────────────────────────────────────────────────────────

  function thumbs() {
    return [...view.querySelectorAll<HTMLImageElement>("img[data-lb-index]")];
  }

  /** One slide per index; a gallery photo's alt is its caption. */
  function collectSlides(): Slide[] {
    const title = document.getElementById("detail-title")?.textContent ?? "";
    const out: Slide[] = [];
    thumbs().forEach((img) => {
      const i = Number(img.dataset.lbIndex);
      const caption = img.alt && img.alt !== title ? img.alt : "";
      if (!out[i]) out[i] = { src: img.getAttribute("src") ?? "", caption };
      else if (!out[i].caption) out[i].caption = caption;
    });
    return out;
  }

  /** Rebuilds the carousel only when the project or its photos changed. */
  function buildSlides() {
    slides = collectSlides();
    const key = slides.map((s) => s.src).join("|");
    if (key === builtFor) return;
    builtFor = key;
    wrapper.replaceChildren(
      ...slides.map((s) => {
        const slide = document.createElement("div");
        slide.className = "swiper-slide lb__slide";
        const frame = document.createElement("div");
        frame.className = "lb__frame";
        const img = document.createElement("img");
        // `src` is filled in on demand (current ± 1), see hydrateSlides.
        img.dataset.src = s.src;
        img.decoding = "async";
        img.draggable = false;
        frame.append(img);
        slide.append(frame);
        return slide;
      })
    );
    swiper?.update();
  }

  function slideImages() {
    return wrapper.querySelectorAll<HTMLImageElement>(".lb__slide img");
  }

  /**
   * Neighbours are held off during the open, so their decode doesn't land in
   * the frames the transition is animating on.
   */
  function hydrateSlides(index: number, neighbours = true) {
    const imgs = slideImages();
    const wanted = neighbours ? [index - 1, index, index + 1] : [index];
    wanted.forEach((i) => {
      const img = imgs[i];
      if (!img || img.getAttribute("src")) return;
      img.setAttribute("src", img.dataset.src!);
    });
  }

  function currentImage(): HTMLImageElement | null {
    return slideImages()[swiper?.activeIndex ?? 0] ?? null;
  }

  function t() {
    return COPY[(document.documentElement.lang as Lang) === "es" ? "es" : "en"];
  }

  function syncChrome(index: number) {
    const total = slides.length;
    counterIndex.textContent = pad(index + 1);
    counterTotal.textContent = pad(total);
    const alt = slides[index]?.caption ?? "";
    captionEl.textContent = alt;
    const img = slideImages()[index];
    if (img) img.alt = alt || titleEl.textContent || "";
    gsap.to(progressFill, {
      scaleX: total ? (index + 1) / total : 0,
      duration: 0.5,
      ease: "power3.out",
    });
    prevBtn.disabled = index === 0;
    nextBtn.disabled = index === total - 1;
  }

  /** Labels that aren't plain text, in the page's current language. */
  function syncLabels() {
    const copy = t();
    root.setAttribute("aria-label", copy.lbGallery);
    closeBtn.setAttribute("aria-label", copy.lbClose);
    prevBtn.setAttribute("aria-label", copy.lbPrev);
    nextBtn.setAttribute("aria-label", copy.lbNext);
  }

  /** The on-page photo for a slide (the first, if it appears twice). */
  function thumbFor(index: number): HTMLImageElement | null {
    return view.querySelector<HTMLImageElement>(`img[data-lb-index="${index}"]`);
  }

  // ───────────────────────────────────────────────────────────────────────
  // GEOMETRY — the morph has to start on the photo's painted pixels:
  // gallery frames show it whole, but the hero banner crops it (cover).
  // ───────────────────────────────────────────────────────────────────────

  function stageRect(): Rect {
    const r = swiperEl.getBoundingClientRect();
    return { left: r.left, top: r.top, width: r.width, height: r.height };
  }

  /** Natural aspect fitted (contain) into the stage — where the photo lands. */
  function fittedRect(natW: number, natH: number): Rect {
    const s = stageRect();
    const k = Math.min(s.width / natW, s.height / natH);
    const width = natW * k;
    const height = natH * k;
    return {
      left: s.left + (s.width - width) / 2,
      top: s.top + (s.height - height) / 2,
      width,
      height,
    };
  }

  /** Where the photo's content sits on screen, and the part its frame shows. */
  function thumbGeometry(img: HTMLImageElement) {
    const natW = img.naturalWidth;
    const natH = img.naturalHeight;
    if (!natW || !natH) return null;

    const b = img.getBoundingClientRect();
    const fit = getComputedStyle(img).objectFit;
    const scale =
      fit === "contain" ? Math.min(b.width / natW, b.height / natH) : Math.max(b.width / natW, b.height / natH);

    const contentW = natW * scale;
    const contentH = natH * scale;
    const contentLeft = b.left + (b.width - contentW) / 2;
    const contentTop = b.top + (b.height - contentH) / 2;

    // Visible window = frame clip ∩ content box ∩ the detail view's viewport.
    const w = ((img.closest(".media") as HTMLElement | null) ?? img).getBoundingClientRect();
    const v = view.getBoundingClientRect();
    const visLeft = Math.max(w.left, v.left, contentLeft);
    const visTop = Math.max(w.top, v.top, contentTop);
    const visRight = Math.min(w.right, v.right, contentLeft + contentW);
    const visBottom = Math.min(w.bottom, v.bottom, contentTop + contentH);
    if (visRight <= visLeft || visBottom <= visTop) return null;

    return { natW, scale, contentLeft, contentTop, visLeft, visTop, visRight, visBottom };
  }

  /**
   * Start state for the morph in its own (final) coordinate space: the
   * translate + uniform scale that maps the final rect onto the photo on the
   * page, plus the clip inset that reproduces its crop.
   */
  function morphStart(img: HTMLImageElement, final: Rect) {
    const g = thumbGeometry(img);
    if (!g) return null;

    const s = g.scale / (final.width / g.natW);
    const x = g.contentLeft - final.left;
    const y = g.contentTop - final.top;

    const clip: Inset = {
      l: (g.visLeft - g.contentLeft) / s,
      t: (g.visTop - g.contentTop) / s,
      r: final.width - (g.visRight - g.contentLeft) / s,
      b: final.height - (g.visBottom - g.contentTop) / s,
    };
    return { x, y, scale: s, clip };
  }

  function applyClip(el: HTMLElement, c: Inset) {
    el.style.clipPath = `inset(${c.t}px ${c.r}px ${c.b}px ${c.l}px)`;
  }

  const nextFrame = () => new Promise<void>((r) => requestAnimationFrame(() => r()));

  // ───────────────────────────────────────────────────────────────────────
  // SWIPER
  // ───────────────────────────────────────────────────────────────────────

  function ensureSwiper() {
    if (swiper) {
      swiper.update();
      return;
    }
    swiper = new Swiper(swiperEl, {
      slidesPerView: 1,
      spaceBetween: 40,
      speed: 620,
      // Arrow keys and zoom are handled below; Swiper's own modules would
      // double the keys and can only jump to a fixed zoom ratio.
      on: {
        slideChange: (sw) => {
          resetZoom(false);
          hydrateSlides(sw.activeIndex);
          syncChrome(sw.activeIndex);
        },
      },
    });

    swiperEl.addEventListener("click", onStageClick);
    backdrop.addEventListener("click", () => close());
    root.addEventListener("wheel", onWheel, { passive: false });
    swiperEl.addEventListener("dblclick", onDoubleClick);
    swiperEl.addEventListener("pointerdown", onPointerDown);
    // A pinch or pan regularly travels outside the stage.
    window.addEventListener("pointermove", onPointerMove, { passive: false });
    window.addEventListener("pointerup", onPointerUp);
    window.addEventListener("pointercancel", onPointerUp);
  }

  function onStageClick(e: MouseEvent) {
    if (!isOpen || isAnimating) return;
    if (swiper && swiper.allowClick === false) return; // tail of a swipe
    if (didPan) return;
    // Clicking the empty area around the photo dismisses.
    if (!(e.target as HTMLElement).closest(".lb__frame img") && zScale <= 1.01) close();
  }

  // ───────────────────────────────────────────────────────────────────────
  // ZOOM — wheel, trackpad pinch (ctrl + wheel) and two-finger pinch all
  // drive one continuous scale, anchored under the cursor or the fingers.
  // ───────────────────────────────────────────────────────────────────────

  let zScale = 1;
  let zX = 0;
  let zY = 0;
  const pointers = new Map<number, { x: number; y: number }>();
  let pinchStartDist = 0;
  let pinchStartScale = 1;
  let panStart: { x: number; y: number; zx: number; zy: number } | null = null;
  let didPan = false;

  function activeImg() {
    return (swiper?.slides?.[swiper.activeIndex]?.querySelector(".lb__frame img") as HTMLImageElement | null) ?? null;
  }

  /** Up to the photo's own resolution (past 1:1 only buys blur), at least 3×. */
  function maxScale(img: HTMLImageElement) {
    const fitted = img.clientWidth || 1;
    return Math.min(6, Math.max(3, (img.naturalWidth || fitted) / fitted));
  }

  function clampPan(img: HTMLImageElement) {
    const frame = img.parentElement as HTMLElement;
    const limitX = Math.max(0, (img.clientWidth * zScale - frame.clientWidth) / 2);
    const limitY = Math.max(0, (img.clientHeight * zScale - frame.clientHeight) / 2);
    zX = Math.min(limitX, Math.max(-limitX, zX));
    zY = Math.min(limitY, Math.max(-limitY, zY));
  }

  function applyZoom(img: HTMLImageElement, animate: boolean) {
    clampPan(img);
    const zoomed = zScale > 1.01;
    root.classList.toggle("is-zoomed", zoomed);
    // A zoomed photo owns the horizontal drag; otherwise it belongs to Swiper.
    if (swiper) swiper.allowTouchMove = !zoomed;
    const to = { x: zX, y: zY, scale: zScale, force3D: true };
    if (animate) gsap.to(img, { ...to, duration: 0.35, ease: "power3.out" });
    else gsap.set(img, to);
  }

  /** Scale by `factor`, holding the viewport point (px, py) still. */
  function zoomAt(factor: number, px: number, py: number, animate = false) {
    const img = activeImg();
    if (!img) return;
    const prev = zScale;
    const next = Math.min(maxScale(img), Math.max(1, prev * factor));
    if (next === prev) return;

    const box = (img.parentElement as HTMLElement).getBoundingClientRect();
    const ax = px - (box.left + box.width / 2);
    const ay = py - (box.top + box.height / 2);

    zX = ax - (next / prev) * (ax - zX);
    zY = ay - (next / prev) * (ay - zY);
    zScale = next;
    if (zScale <= 1.01) {
      zScale = 1;
      zX = 0;
      zY = 0;
    }
    applyZoom(img, animate);
  }

  function resetZoom(animate: boolean) {
    const img = activeImg();
    zScale = 1;
    zX = 0;
    zY = 0;
    root.classList.remove("is-zoomed", "is-panning");
    if (swiper) swiper.allowTouchMove = true;
    if (!img) return;
    if (animate) gsap.to(img, { x: 0, y: 0, scale: 1, duration: 0.35, ease: "power3.out" });
    else gsap.set(img, { x: 0, y: 0, scale: 1 });
  }

  function onWheel(e: WheelEvent) {
    if (!isOpen) return;
    // Nothing here scrolls, so the wheel is always swallowed.
    e.preventDefault();
    if (isAnimating) return;
    if (!(e.target as HTMLElement).closest(".lb__swiper")) return;
    let dy = e.deltaY;
    if (e.deltaMode === 1) dy *= 16;
    else if (e.deltaMode === 2) dy *= 400;
    zoomAt(Math.exp(-dy * (e.ctrlKey ? 0.012 : 0.0025)), e.clientX, e.clientY);
  }

  function onDoubleClick(e: MouseEvent) {
    if (!isOpen || isAnimating) return;
    if (!(e.target as HTMLElement).closest(".lb__frame")) return;
    if (zScale > 1.01) resetZoom(true);
    else zoomAt(2, e.clientX, e.clientY, true);
  }

  function pinchDistance() {
    const [a, b] = [...pointers.values()];
    return Math.hypot(a.x - b.x, a.y - b.y);
  }

  function pinchCentre() {
    const [a, b] = [...pointers.values()];
    return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
  }

  function onPointerDown(e: PointerEvent) {
    if (!isOpen) return;
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pointers.size === 2) {
      pinchStartDist = pinchDistance();
      pinchStartScale = zScale;
      panStart = null;
      if (swiper) swiper.allowTouchMove = false;
    } else if (pointers.size === 1 && zScale > 1.01) {
      panStart = { x: e.clientX, y: e.clientY, zx: zX, zy: zY };
      didPan = false;
      root.classList.add("is-panning");
    }
  }

  function onPointerMove(e: PointerEvent) {
    if (!isOpen || !pointers.has(e.pointerId)) return;
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

    if (pointers.size === 2 && pinchStartDist > 0) {
      e.preventDefault();
      const img = activeImg();
      if (!img) return;
      const centre = pinchCentre();
      const target = Math.min(maxScale(img), Math.max(1, (pinchStartScale * pinchDistance()) / pinchStartDist));
      zoomAt(target / zScale, centre.x, centre.y);
      return;
    }

    if (panStart && pointers.size === 1) {
      const dx = e.clientX - panStart.x;
      const dy = e.clientY - panStart.y;
      if (Math.abs(dx) > 3 || Math.abs(dy) > 3) didPan = true;
      zX = panStart.zx + dx;
      zY = panStart.zy + dy;
      const img = activeImg();
      if (img) applyZoom(img, false);
    }
  }

  function onPointerUp(e: PointerEvent) {
    pointers.delete(e.pointerId);
    if (pointers.size < 2) pinchStartDist = 0;
    if (pointers.size === 0) {
      panStart = null;
      root.classList.remove("is-panning");
      if (swiper) swiper.allowTouchMove = zScale <= 1.01;
      if (zScale <= 1.01 && (zX !== 0 || zY !== 0)) resetZoom(true);
      setTimeout(() => {
        didPan = false;
      }, 0);
    }
  }

  // ───────────────────────────────────────────────────────────────────────
  // OPEN
  // ───────────────────────────────────────────────────────────────────────

  async function open(index: number, thumb: HTMLImageElement) {
    if (isOpen || isAnimating) return;
    isOpen = true;
    isAnimating = true;
    lastTrigger = thumb;

    titleEl.textContent = document.getElementById("detail-title")?.textContent ?? "";
    syncLabels();
    root.classList.add("is-open");
    root.classList.remove("is-zoomed");
    swiperEl.style.opacity = "0";
    gsap.set(backdrop, { opacity: 0 });
    gsap.set(ui, { opacity: 0 });

    buildSlides();
    ensureSwiper();
    hydrateSlides(index, false);
    swiper!.slideTo(index, 0, false);
    resetZoom(false);
    syncChrome(index);

    const src = thumb.currentSrc || thumb.src;
    const start =
      reduceMotion() || !thumb.naturalWidth
        ? null
        : (() => {
            const final = fittedRect(thumb.naturalWidth, thumb.naturalHeight);
            const s = morphStart(thumb, final);
            return s ? { final, ...s } : null;
          })();

    const morphed = start ? await primeMorph(src, start.final, start, start.clip) : false;
    if (!isOpen) return;

    tl?.kill();
    tl = gsap.timeline({
      onComplete() {
        isAnimating = false;
        // Hand off from the morph to the live slide — same photo, same rect.
        swiperEl.style.opacity = "1";
        morph.classList.remove("is-active");
        root.focus({ preventScroll: true });
        hydrateSlides(index);
      },
    });

    const dur = openDuration();
    tl.to(backdrop, { opacity: 1, duration: dur * 0.5, ease: "power2.out" }, 0);

    if (morphed) {
      hiddenThumb = thumb;
      thumb.style.opacity = "0";
      tl.to(morph, { x: 0, y: 0, scale: 1, duration: dur, ease: openEase(), force3D: true }, 0);
      addClipTween(tl, start!.clip, { t: 0, r: 0, b: 0, l: 0 }, dur, openEase());
    } else {
      tl.fromTo(swiperEl, { opacity: 0 }, { opacity: 1, duration: 0.45, ease: "power2.out" }, 0);
    }

    // The chrome finishes WITH the photo, so it can be swiped as it lands.
    tl.to(ui, { opacity: 1, duration: dur * 0.6, ease: "power2.out" }, dur * 0.4);
  }

  /**
   * Stage the morph while hidden — box, source, starting transform, clip —
   * and reveal it only once decoded, or it flashes its previous photo.
   * Returns false if the pixels never arrived, so the caller cross-fades.
   */
  async function primeMorph(
    src: string,
    final: Rect,
    from: { x: number; y: number; scale: number },
    clip: Inset
  ): Promise<boolean> {
    morph.style.left = `${final.left}px`;
    morph.style.top = `${final.top}px`;
    morph.style.width = `${final.width}px`;
    morph.style.height = `${final.height}px`;
    if (morphImg.getAttribute("src") !== src) morphImg.setAttribute("src", src);
    gsap.set(morph, { x: from.x, y: from.y, scale: from.scale, force3D: true });
    applyClip(morph, clip);

    await Promise.race([morphImg.decode().catch(() => {}), new Promise((r) => setTimeout(r, 140))]);
    if (!morphImg.complete || !morphImg.naturalWidth) return false;
    morph.classList.add("is-active");
    return true;
  }

  /** Tweens the clip only when it actually moves; otherwise it's just repaint. */
  function addClipTween(timeline: gsap.core.Timeline, from: Inset, to: Inset, duration: number, ease: string) {
    const travel = Math.max(
      Math.abs(to.t - from.t),
      Math.abs(to.r - from.r),
      Math.abs(to.b - from.b),
      Math.abs(to.l - from.l)
    );
    if (travel < 0.5) {
      morph.style.clipPath = "none";
      return;
    }
    const clip = { ...from };
    applyClip(morph, clip);
    timeline.to(clip, { ...to, duration, ease, onUpdate: () => applyClip(morph, clip) }, 0);
  }

  // ───────────────────────────────────────────────────────────────────────
  // CLOSE — the detail view is first scrolled, under the opaque backdrop, so
  // the photo on screen is in view; then the photo shrinks back into it.
  // ───────────────────────────────────────────────────────────────────────

  async function close() {
    if (!isOpen || isAnimating) return;

    // First Esc / close press just exits zoom.
    if (zScale > 1.01) {
      resetZoom(true);
      return;
    }

    isAnimating = true;
    const index = swiper?.activeIndex ?? 0;
    const slideImg = currentImage();

    tl?.kill();
    gsap.to(ui, { opacity: 0, duration: 0.2, ease: "power2.out" });

    const thumb = thumbFor(index);
    if (thumb) revealThumb(thumb);
    await nextFrame();
    await nextFrame();

    const src = slideImg?.currentSrc || slideImg?.src || "";
    const natW = slideImg?.naturalWidth ?? 0;
    const natH = slideImg?.naturalHeight ?? 0;

    const end =
      reduceMotion() || !thumb || !natW || !src
        ? null
        : (() => {
            const final = fittedRect(natW, natH);
            const s = morphStart(thumb, final);
            return s ? { final, ...s } : null;
          })();

    const morphed = end ? await primeMorph(src, end.final, { x: 0, y: 0, scale: 1 }, { t: 0, r: 0, b: 0, l: 0 }) : false;

    tl = gsap.timeline({
      onComplete() {
        // Focus returns to the photo you landed on.
        finishClose(thumb ?? lastTrigger);
      },
    });

    const dur = closeDuration();

    if (morphed) {
      restoreThumb();
      hiddenThumb = thumb!;
      thumb!.style.opacity = "0";
      swiperEl.style.opacity = "0";

      tl.to(morph, { x: end!.x, y: end!.y, scale: end!.scale, duration: dur, ease: closeEase(), force3D: true }, 0);
      addClipTween(tl, { t: 0, r: 0, b: 0, l: 0 }, end!.clip, dur, closeEase());
      tl.to(backdrop, { opacity: 0, duration: dur * 0.65, ease: "power2.inOut" }, dur * 0.26);
    } else {
      tl.to(swiperEl, { opacity: 0, duration: 0.3, ease: "power2.in" }, 0).to(
        backdrop,
        { opacity: 0, duration: 0.4, ease: "power2.inOut" },
        0.05
      );
    }
  }

  function finishClose(focusTarget: HTMLElement | null = lastTrigger) {
    root.classList.remove("is-open", "is-zoomed", "is-panning");
    morph.classList.remove("is-active");
    swiperEl.style.opacity = "0";
    pointers.clear();
    pinchStartDist = 0;
    panStart = null;
    resetZoom(false);
    restoreThumb();
    isOpen = false;
    isAnimating = false;
    focusTarget?.focus?.({ preventScroll: true });
    lastTrigger = null;
  }

  function restoreThumb() {
    if (hiddenThumb) hiddenThumb.style.opacity = "";
    hiddenThumb = null;
  }

  /** Scrolls the detail view to a photo, unless it is already mostly in view. */
  function revealThumb(thumb: HTMLImageElement) {
    const r = ((thumb.closest(".media") as HTMLElement | null) ?? thumb).getBoundingClientRect();
    const vh = view.clientHeight;
    const visible = Math.max(0, Math.min(r.bottom, vh) - Math.max(r.top, 0));
    if (visible / Math.min(r.height, vh) >= 0.6) return;

    const y = r.height > vh * 0.9 ? view.scrollTop + r.top - vh * 0.08 : view.scrollTop + r.top - (vh - r.height) / 2;
    view.scrollTo({ top: Math.max(0, y), behavior: "instant" });
  }

  // ───────────────────────────────────────────────────────────────────────
  // WIRING
  // ───────────────────────────────────────────────────────────────────────

  function thumbFrom(e: Event) {
    return (e.target as HTMLElement)?.closest<HTMLImageElement>("img[data-lb-index]");
  }

  view.addEventListener("click", (e) => {
    const img = thumbFrom(e);
    if (!img) return;
    e.preventDefault();
    open(Number(img.dataset.lbIndex), img);
  });

  view.addEventListener("keydown", (e) => {
    if (e.key !== "Enter" && e.key !== " ") return;
    const img = thumbFrom(e);
    if (!img) return;
    e.preventDefault();
    open(Number(img.dataset.lbIndex), img);
  });

  // Capture phase, so Esc closes the viewer instead of the detail view
  // underneath (site.ts closes the top view on Esc).
  window.addEventListener(
    "keydown",
    (e) => {
      if (!isOpen) return;
      if (e.key === "Escape") {
        e.preventDefault();
        e.stopPropagation();
        close();
      } else if (e.key === "ArrowLeft") {
        e.stopPropagation();
        swiper?.slidePrev();
      } else if (e.key === "ArrowRight") {
        e.stopPropagation();
        swiper?.slideNext();
      } else if (e.key === "Tab") {
        trapFocus(e);
      }
    },
    true
  );

  /** Keep Tab inside the dialog — it's modal. */
  function trapFocus(e: KeyboardEvent) {
    const stops = [...root.querySelectorAll<HTMLElement>(".lb__close, .lb__nav:not(:disabled)")].filter(
      (el) => el.offsetParent !== null
    );
    if (!stops.length) return;
    const first = stops[0];
    const last = stops[stops.length - 1];
    const active = document.activeElement;
    if (e.shiftKey && (active === first || active === root)) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && active === last) {
      e.preventDefault();
      first.focus();
    } else if (!root.contains(active)) {
      e.preventDefault();
      first.focus();
    }
  }

  /** The stage moved: re-aim a morph in flight, or just re-lay the carousel. */
  function onViewportChange() {
    if (!isOpen) return;
    if (morph.classList.contains("is-active")) {
      if (morphImg.naturalWidth) {
        const final = fittedRect(morphImg.naturalWidth, morphImg.naturalHeight);
        morph.style.left = `${final.left}px`;
        morph.style.top = `${final.top}px`;
        morph.style.width = `${final.width}px`;
        morph.style.height = `${final.height}px`;
      }
      return;
    }
    resetZoom(false);
    swiper?.update();
  }

  closeBtn.addEventListener("click", () => close());
  prevBtn.addEventListener("click", () => swiper?.slidePrev());
  nextBtn.addEventListener("click", () => swiper?.slideNext());
  window.addEventListener("resize", onViewportChange);
  window.visualViewport?.addEventListener("resize", onViewportChange);
  root.addEventListener("touchmove", (e) => isOpen && e.preventDefault(), { passive: false });
  // site.ts redraws the detail in the new language before firing this, so
  // the photos' alts already carry the translated captions.
  window.addEventListener("relux:lang", () => {
    if (!isOpen) return;
    syncLabels();
    titleEl.textContent = document.getElementById("detail-title")?.textContent ?? "";
    slides = collectSlides();
    syncChrome(swiper?.activeIndex ?? 0);
  });
</script>
