---
/** Cream dot that trails the pointer and swells over anything interactive. */
---

<div id="cursor" aria-hidden="true"></div>

<style>
  #cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 11px;
    height: 11px;
    border-radius: 999px;
    background: var(--color-cream);
    pointer-events: none;
    z-index: 9999;
    opacity: 0;
    transform: translate(-50%, -50%);
    transition:
      width 0.22s ease,
      height 0.22s ease,
      opacity 0.22s ease,
      background 0.22s ease;
  }
  #cursor.is-over {
    width: 34px;
    height: 34px;
    background: rgb(132 127 120 / 0.32);
  }

  /* Touch devices keep the native cursor, so this never shows */
  @media (hover: none) {
    #cursor {
      display: none;
    }
  }
</style>

<script>
  const dot = document.getElementById("cursor");
  const coarse = window.matchMedia("(hover: none)").matches;

  if (dot && !coarse) {
    const INTERACTIVE = "a, button, input, textarea, select, label, [role='button']";

    let x = 0,
      y = 0,
      cx = 0,
      cy = 0,
      seen = false;

    window.addEventListener(
      "pointermove",
      (e: PointerEvent) => {
        x = e.clientX;
        y = e.clientY;
        if (!seen) {
          cx = x;
          cy = y;
          seen = true;
          dot.style.opacity = "1";
        }
        const el = e.target as Element | null;
        dot.classList.toggle("is-over", !!el?.closest?.(INTERACTIVE));
      },
      { passive: true }
    );

    document.addEventListener("mouseleave", () => {
      dot.style.opacity = "0";
    });
    document.addEventListener("mouseenter", () => {
      if (seen) dot.style.opacity = "1";
    });

    // The dot lives inside the zoomed page, so its own px are scaled up —
    // pointer coordinates are not. Divide to keep it under the cursor.
    const zoom = () =>
      parseFloat(
        getComputedStyle(document.documentElement).getPropertyValue("--zoom")
      ) || 1;

    const tick = () => {
      cx += (x - cx) * 0.35;
      cy += (y - cy) * 0.35;
      const z = zoom();
      dot.style.transform =
        `translate(${(cx / z).toFixed(1)}px, ${(cy / z).toFixed(1)}px)` +
        " translate(-50%, -50%)";
      requestAnimationFrame(tick);
    };
    tick();
  }
</script>
