---
import { SERVICES, COPY } from "../data/copy";

const en = COPY.en;
---

<section class="services" id="services">
  <div class="sec-head services__head">
    <h2 class="sec-head__title">
      <span data-i18n="servicesKicker">OUR</span><br />
      <em data-i18n="servicesWord">SERVICES</em>
    </h2>
    <p class="sec-head__intro" data-i18n="servicesIntro">
      {en.servicesIntro}
    </p>
  </div>

  <div class="services__strip">
    {
      SERVICES.map((s, i) => (
        <article
          class:list={["panel", { "is-on": i === 0 }]}
          data-svc
          style={`--flex-base:${s.grow};--flex-hover:${s.hover}`}
        >
          <img src={s.img} alt="" loading="lazy" aria-hidden="true" />
          <div class="panel__scrim" />
          <div class="panel__body">
            <span class="num">{s.n}</span>
            <h3 class="panel__title" data-i18n={s.titleKey}>
              {en[s.titleKey]}
            </h3>
            <p class="panel__desc" data-i18n={s.descKey}>
              {en[s.descKey]}
            </p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .services {
    position: relative;
    padding: 128px 0 0;
    background: var(--color-ink);
  }

  .services__head {
    padding: 0 var(--gutter) 56px;
  }

  .services__strip {
    display: flex;
    gap: 4px;
    height: 560px;
    padding: 0 4px;
  }

  .panel {
    position: relative;
    flex: var(--flex-base) 1 0;
    min-width: 0;
    overflow: hidden;
    background: var(--color-ink-3);
    transition: flex 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .panel > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .panel__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(6 5 4 / 0.9) 0%,
      rgb(6 5 4 / 0.15) 58%,
      rgb(6 5 4 / 0.33) 100%
    );
  }
  .panel__body {
    position: absolute;
    left: 32px;
    right: 32px;
    bottom: 32px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .panel__title {
    font-size: var(--fs-h3-lg);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.2;
    color: var(--color-cream);
  }
  .panel__desc {
    max-width: 340px;
    font-size: var(--fs-xs);
    font-weight: 300;
    line-height: 1.6;
    color: rgb(239 226 196 / 0.6);
  }

  /* Desktop with a mouse: the hovered panel widens */
  @media (hover: hover) and (min-width: 1081px) {
    .panel:hover {
      flex: var(--flex-hover) 1 0;
    }
  }

  /* No hover to lean on (touch, or the stacked tablet/phone layout): a tap
     opens a panel instead, and only the open one shows its description. */
  @media (hover: none), (max-width: 1080px) {
    .panel {
      flex: 1 1 0;
      cursor: pointer;
    }
    .panel.is-on {
      flex: 3.2 1 0;
    }
    .panel__desc {
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition:
        opacity 0.5s ease,
        max-height 0.5s ease;
    }
    .panel.is-on .panel__desc {
      max-height: 120px;
      opacity: 1;
      transition-delay: 0.25s;
    }
    .panel__title {
      transition: font-size 0.4s ease;
    }
    .panel:not(.is-on) .panel__body {
      left: 16px;
      right: 16px;
      bottom: 24px;
    }
    .panel:not(.is-on) .panel__title {
      font-size: 14px;
      line-height: 1.25;
      overflow-wrap: anywhere;
    }
  }

  /* Stacked: collapsed panels are 132px bands, the open one grows */
  @media (max-width: 1080px) {
    .services__strip {
      flex-direction: column;
      height: auto;
    }
    .panel,
    .panel.is-on {
      flex: none;
    }
    .panel {
      height: 132px;
      transition: height 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .panel {
      cursor: default;
    }
    .panel.is-on {
      height: 460px;
    }
    .panel:not(.is-on) .panel__body {
      left: 20px;
      right: 20px;
    }
    .panel:not(.is-on) .panel__title {
      font-size: 20px;
    }
  }

  @media (max-width: 720px) {
    .services {
      padding-top: 80px;
    }
    .panel.is-on {
      height: 400px;
    }
  }
</style>

<script>
  const panels = [...document.querySelectorAll<HTMLElement>("[data-svc]")];
  const stacked = window.matchMedia("(max-width: 1080px)");

  // Side by side: a tap opens a panel and closes the rest
  panels.forEach((panel) =>
    panel.addEventListener("click", () => {
      if (stacked.matches) return;
      panels.forEach((p) => p.classList.toggle("is-on", p === panel));
    })
  );

  // Stacked: each panel opens by itself once its top climbs past 80% of the
  // viewport and then stays open. Panels only ever grow below what is on
  // screen, so the page never jumps.
  let ticking = false;
  const reveal = () => {
    ticking = false;
    if (!stacked.matches) return;
    const line = window.innerHeight * 0.8;
    panels.forEach((p) => {
      if (p.getBoundingClientRect().top < line) p.classList.add("is-on");
    });
  };
  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(reveal);
    }
  };
  const setMode = () => {
    if (stacked.matches) {
      panels.forEach((p) => p.classList.remove("is-on"));
      reveal();
    } else {
      panels.forEach((p, i) => p.classList.toggle("is-on", i === 0));
    }
  };

  setMode();
  stacked.addEventListener("change", setMode);
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll);
</script>
