---
import { WORK, COPY, INSTAGRAM } from "../../data/copy";
import Contact from "../Contact.astro";
import Footer from "../Footer.astro";
import ProjectCard from "../ProjectCard.astro";
import ArrowBack from "../icons/ArrowBack.astro";
import ArrowUpRight from "../icons/ArrowUpRight.astro";

interface Props {
  /** Rendered already open, for the page at this view's own address. */
  open?: boolean;
  /** The page's one contact section moves into this view while it is on top
   *  (site.ts), instead of the view carrying a copy of its own. */
  shareContact?: boolean;
}

const { open = false, shareContact = false } = Astro.props;
/** Open on load means this view is the page, so its title is the page's h1. */
const Title = open ? "h1" : "h2";
const en = COPY.en;
---

<div class="view" id="view-work" role="dialog" aria-modal="true" aria-label="All projects" data-i18n-label="viewWork" hidden={!open}>
  <div class="view__bar">
    <button type="button" class="btn btn--ghost btn--back" data-close="work">
      <ArrowBack />
      <span data-i18n="workBack">Back</span>
    </button>
    <a
      href={INSTAGRAM.url}
      target="_blank"
      rel="noopener"
      class="view__bar-meta">{INSTAGRAM.handle}</a
    >
  </div>

  <div class="sec-head workview__head">
    <Title class="sec-head__title">
      <span data-i18n="workTitle">All</span><br />
      <em data-i18n="workTitleEm">Projects</em>
    </Title>
    <p class="sec-head__intro" data-i18n="workIntro">{en.workIntro}</p>
  </div>

  <div class="grid-3 workview__grid">
    {/* At its own address the first row is what loads on screen */}
    {WORK.map((p, i) => <ProjectCard project={p} priority={open && i < 3 ? (i === 0 ? "high" : "auto") : undefined} />)}
  </div>

  <div class="view__foot">
    <p data-i18n="workFoot">{en.workFoot}</p>
    <button type="button" class="btn btn--solid" data-close="work" data-goto="contact">
      <span data-i18n="workCta">Request a Quote</span>
      <ArrowUpRight />
    </button>
  </div>

  {shareContact ? <div data-contact-slot /> : <Contact inView />}
  <Footer />
</div>

<style>
  .workview__head {
    padding: 88px var(--gutter) 56px;
  }

  .workview__grid {
    padding: 0 var(--gutter) 96px;
  }
</style>
