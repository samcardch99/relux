---
import { COPY, DETAIL, PROJECTS, SHOTS } from "../../data/copy";
import Contact from "../Contact.astro";
import Footer from "../Footer.astro";
import ArrowBack from "../icons/ArrowBack.astro";
import ArrowUpRight from "../icons/ArrowUpRight.astro";

interface Props {
  /**
   * Project shown when the page loads at its own address. Only the top of the
   * view is rendered here (so it reads right before scripts run, and to search
   * engines); site.ts fills in the rest and redraws it all on language change.
   */
  index?: number;
  /** The page's one contact section moves into this view while it is on top
   *  (site.ts), instead of the view carrying a copy of its own. */
  shareContact?: boolean;
}

const { index, shareContact = false } = Astro.props;
const en = COPY.en;
const project = index === undefined ? undefined : PROJECTS[index];
const entry = index === undefined ? undefined : DETAIL.en[index];
const shots = index === undefined ? undefined : SHOTS[index];
const hero = shots?.hero ?? "";
const tag = project ? en[project.tagKey] : "";
const title = project ? en[project.titleKey] : "";
/** A project loaded at its own address is the page: its title is the h1. */
const Title = project ? "h1" : "h2";
---

<div
  class="view view--detail"
  id="view-detail"
  role="dialog"
  aria-modal="true"
  aria-labelledby="detail-title"
  hidden={!project}
>
  <div class="view__bar">
    <button type="button" class="btn btn--ghost btn--back" data-close="detail">
      <ArrowBack />
      <span data-i18n="workBack">Back</span>
    </button>
    <span class="view__bar-meta" id="detail-tag">{tag}</span>
  </div>

  <!-- One photo cropped to the banner, or, for projects drawn in portrait
       (`heroSet` in SHOTS), three portraits side by side at full size. -->
  <div class:list={["media detail__hero", { "is-set": shots?.heroSet }]} id="detail-hero-box">
    <img
      id="detail-hero"
      src={hero}
      alt={title}
      fetchpriority={project ? "high" : undefined}
      hidden={!!shots?.heroSet}
      style={shots?.heroFocus ? `object-position:${shots.heroFocus}` : undefined}
    />
    <div class="detail__set" id="detail-hero-set" hidden={!shots?.heroSet}>
      {[0, 1, 2].map((n) => (
        <div class="media"><img id={`detail-hero-${n + 1}`} src={shots?.heroSet?.[n]} alt={title} /></div>
      ))}
    </div>
    <div class="detail__hero-scrim"></div>
  </div>

  <div class="detail__intro">
    <div class="detail__copy">
      <Title class="detail__title" id="detail-title">{title}</Title>
      <p class="detail__summary" id="detail-summary">{entry?.summary}</p>
      <div class="detail__paras" id="detail-paras">{entry?.paras.map((text) => <p>{text}</p>)}</div>
    </div>

    <dl class="detail__meta" id="detail-meta">
      {
        entry?.meta.map(([key, value]) => (
          <div>
            <dt>{key}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <!-- Before/after comparison. Only shown for projects that have a "before"
       photo (see SHOTS in src/data/copy.ts). -->
  <div class="ba" id="detail-ba" hidden>
    <div class="ba__head">
      <h3 class="ba__title" data-i18n="baTitle">{en.baTitle}</h3>
      <span class="ba__hint" data-i18n="baHint">{en.baHint}</span>
    </div>
    <div class="ba__stage media" id="ba-stage">
      <img id="ba-after" alt="" draggable="false" />
      <div class="ba__clip" id="ba-clip">
        <img id="ba-before" alt="" draggable="false" />
      </div>
      <span class="ba__tag" data-i18n="baBefore">{en.baBefore}</span>
      <span class="ba__tag ba__tag--after" data-i18n="baAfter">{en.baAfter}</span>
      <div
        class="ba__handle"
        id="ba-handle"
        role="slider"
        tabindex="0"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="50"
        aria-label="Before / after"
      >
        <span class="ba__line"></span>
        <span class="ba__knob">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m9 6-6 6 6 6" />
            <path d="m15 6 6 6-6 6" />
          </svg>
        </span>
      </div>
    </div>
  </div>

  <!-- Video row: only for projects with a video (see SHOTS), beside one
       portrait. site.ts sizes both columns so they share one height. -->
  <div class="vid" id="detail-vid" hidden>
    <div class="ba__head">
      <h3 class="ba__title" data-i18n="vidTitle">{en.vidTitle}</h3>
      <span class="ba__hint" id="detail-vid-tag">{tag}</span>
    </div>
    <div class="vid__row" id="detail-vid-row">
      <div class="media vid__frame" id="detail-vid-frame">
        <video id="detail-video" muted loop playsinline controls preload="metadata"></video>
      </div>
      <div class="media vid__side">
        <img id="detail-side" alt="" loading="lazy" />
      </div>
    </div>
  </div>

  <div class="detail__shots" id="detail-shots"></div>

  <div class="view__foot detail__foot">
    <p data-i18n="detailFoot">{en.detailFoot}</p>
    <div class="detail__actions">
      <button type="button" class="btn btn--ghost" data-close="detail">
        <span data-i18n="detailBack">Back to projects</span>
      </button>
      <button
        type="button"
        class="btn btn--solid"
        data-close="detail"
        data-goto="contact"
      >
        <span data-i18n="workCta">Request a Quote</span>
        <ArrowUpRight />
      </button>
    </div>
  </div>

  {shareContact ? <div data-contact-slot /> : <Contact inView />}
  <Footer />
</div>

<style>
  .detail__hero {
    /* 62vh in the design; compensated for the page zoom like the main hero */
    height: calc(62svh / var(--zoom, 1));
    min-height: 300px;
  }
  .detail__hero > img[hidden],
  .detail__set[hidden] {
    display: none;
  }

  /* Three 4:5 portraits at the banner's height. Where the screen is too
     narrow for that, the banner gets shorter instead of cropping them. */
  .detail__hero.is-set {
    container-type: inline-size;
    height: auto;
    min-height: 0;
    background: none;
  }
  .detail__set {
    --set-gap: 8px;
    display: flex;
    justify-content: center;
    gap: var(--set-gap);
    height: min(calc(62svh / var(--zoom, 1)), calc((100cqw - 2 * var(--set-gap)) / 3 * 1.25));
  }
  .detail__set > .media {
    height: 100%;
    aspect-ratio: 4 / 5;
  }
  .detail__hero-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgb(6 5 4 / 0.2) 0%,
      rgb(6 5 4 / 0) 40%,
      rgb(6 5 4 / 0.8) 100%
    );
  }

  .detail__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 72px;
    padding: 72px var(--gutter) 64px;
  }

  .detail__copy {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .detail__title {
    max-width: 620px;
    font-size: var(--fs-h2-sm);
    font-weight: 300;
    line-height: 1.16;
    color: var(--color-cream);
  }
  .detail__summary {
    max-width: 560px;
    font-size: 16px;
    font-weight: 300;
    line-height: 1.72;
    color: rgb(239 226 196 / 0.7);
  }
  .detail__paras {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 560px;
  }

  .detail__meta {
    align-self: start;
    margin: 0;
    border-top: 1px solid rgb(239 226 196 / 0.14);
  }

  .detail__shots {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 0 var(--gutter) 88px;
  }

  .ba {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 0 var(--gutter) 88px;
  }
  .ba[hidden] {
    display: none;
  }
  .ba__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 24px;
  }
  .ba__title {
    font-size: 30px;
    font-weight: 300;
    line-height: 1.2;
    color: var(--color-cream);
  }
  .ba__hint {
    font-size: var(--fs-label);
    font-weight: 400;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color-stone);
  }
  .ba__stage {
    aspect-ratio: 16 / 9;
    user-select: none;
    touch-action: pan-y;
  }
  .ba__stage img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ba__clip {
    position: absolute;
    inset: 0;
    clip-path: inset(0 50% 0 0);
  }
  .ba__tag {
    position: absolute;
    left: 20px;
    top: 20px;
    z-index: 3;
    pointer-events: none;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgb(6 5 4 / 0.72);
    font-size: var(--fs-label-sm);
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-cream);
  }
  .ba__tag--after {
    left: auto;
    right: 20px;
    background: rgb(232 213 172 / 0.92);
    color: var(--color-ink-2);
  }
  .ba__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    z-index: 4;
    width: 48px;
    margin-left: -24px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: ew-resize;
    touch-action: none;
  }
  .ba__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 23px;
    width: 2px;
    background: var(--color-cream);
  }
  .ba__knob {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--color-cream);
    color: var(--color-ink-2);
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.4);
  }

  .vid {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 0 var(--gutter) 88px;
  }
  .vid[hidden] {
    display: none;
  }
  /* Each column is as wide as its frame's proportion (set by site.ts), so the
     video and the photo come out the same height with nothing cropped. */
  .vid__row {
    display: grid;
    grid-template-columns: var(--cols, minmax(0, 9fr) minmax(0, 20fr));
    gap: 16px;
    align-items: start;
    width: var(--row-width, 100%);
    margin-inline: auto;
  }
  .vid__frame {
    aspect-ratio: var(--ratio, 9 / 16);
    border: 1px solid rgb(239 226 196 / 0.08);
  }
  .vid__frame video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #000;
  }
  .vid__side {
    aspect-ratio: 4 / 5;
  }

  .detail__foot {
    padding-top: 80px;
    border-top: 1px solid rgb(239 226 196 / 0.1);
  }
  .detail__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* 62vh tall with a 420px floor on desktop; fixed heights below */
  @media (max-width: 1080px) {
    .detail__hero {
      height: 320px;
      min-height: 0;
    }
  }
  @media (max-width: 720px) {
    .detail__hero {
      height: 240px;
    }
    /* Too narrow for three whole portraits: they keep the banner's height
       and the strip scrolls sideways instead. */
    .detail__set {
      height: 240px;
      justify-content: flex-start;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .detail__set > .media {
      flex: none;
      scroll-snap-align: start;
    }
    .detail__intro {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
      padding-top: 56px;
    }
    /* The video stacks over its photo */
    .vid__row {
      grid-template-columns: minmax(0, 1fr);
      width: 100%;
    }
    .detail__title {
      font-size: 28px;
    }
  }
</style>

<style is:global>
  /* The paragraphs, meta rows and shots are built at runtime from the project
     data (see src/scripts/site.ts), so they never carry Astro's scoping
     attribute — these rules have to be global to reach them. */
  .detail__paras p {
    font-size: var(--fs-xs);
    font-weight: 300;
    line-height: 1.85;
    color: rgb(239 226 196 / 0.55);
  }

  .detail__meta > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding: 16px 0;
    border-bottom: 1px solid rgb(239 226 196 / 0.14);
  }
  .detail__meta dt {
    font-size: var(--fs-label-sm);
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgb(239 226 196 / 0.4);
  }
  .detail__meta dd {
    margin: 0;
    font-size: 14px;
    font-weight: 300;
    text-align: right;
    color: var(--color-cream);
  }

  /* Each column is as wide as its photo's proportion, so the row shares one
     height; a short last row is narrowed and centred. See renderShots. The
     gap is GALLERY_GAP in site.ts. */
  .detail__row {
    display: grid;
    grid-template-columns: var(--cols);
    gap: 20px;
    align-items: start;
    width: var(--row-width, 100%);
    margin-inline: auto;
  }
  .detail__shots figure {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
  }
  .detail__shots .media {
    aspect-ratio: var(--ratio, 16 / 9);
  }
  /* One photo per row on phones, each still at its own proportion */
  @media (max-width: 720px) {
    .detail__row {
      grid-template-columns: minmax(0, 1fr);
      width: 100%;
    }
  }
  .detail__shots img {
    filter: brightness(0.9);
  }
  /* Every photo in the detail opens the full-screen viewer (ProjectLightbox);
     site.ts marks them with data-lb-index. */
  #view-detail img[data-lb-index]:focus-visible {
    outline: 1px solid rgb(239 226 196 / 0.7);
    outline-offset: -4px;
  }
  .detail__shots figcaption {
    font-size: var(--fs-xs);
    font-weight: 300;
    line-height: 1.7;
    color: rgb(239 226 196 / 0.5);
  }
</style>
