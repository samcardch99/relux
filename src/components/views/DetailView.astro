---
import { COPY } from "../../data/copy";
import ArrowBack from "../icons/ArrowBack.astro";
import ArrowUpRight from "../icons/ArrowUpRight.astro";

const en = COPY.en;
---

<div
  class="view view--detail"
  id="view-detail"
  role="dialog"
  aria-modal="true"
  aria-labelledby="detail-title"
  hidden
>
  <div class="view__bar">
    <button type="button" class="btn btn--ghost btn--back" data-close="detail">
      <ArrowBack />
      <span data-i18n="workBack">Back</span>
    </button>
    <span class="view__bar-meta" id="detail-tag"></span>
  </div>

  <div class="media detail__hero">
    <img id="detail-hero" src="" alt="" />
    <div class="detail__hero-scrim"></div>
  </div>

  <div class="detail__intro">
    <div class="detail__copy">
      <h2 class="detail__title" id="detail-title"></h2>
      <p class="detail__summary" id="detail-summary"></p>
      <div class="detail__paras" id="detail-paras"></div>
    </div>

    <dl class="detail__meta" id="detail-meta"></dl>
  </div>

  <div class="detail__shots" id="detail-shots"></div>

  <div class="view__foot detail__foot">
    <p data-i18n="detailFoot">{en.detailFoot}</p>
    <div class="detail__actions">
      <button type="button" class="btn btn--ghost" data-close="detail">
        <span data-i18n="detailBack">Back to projects</span>
      </button>
      <button
        type="button"
        class="btn btn--solid"
        data-close="detail"
        data-goto="contact"
      >
        <span data-i18n="workCta">Request a Quote</span>
        <ArrowUpRight />
      </button>
    </div>
  </div>
</div>

<style>
  .detail__hero {
    /* 62vh in the design; compensated for the page zoom like the main hero */
    height: calc(62svh / var(--zoom, 1));
    min-height: 300px;
  }
  .detail__hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(6 5 4 / 0.2) 0%,
      rgb(6 5 4 / 0) 40%,
      rgb(6 5 4 / 0.8) 100%
    );
  }

  .detail__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 72px;
    padding: 72px var(--gutter) 64px;
  }

  .detail__copy {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .detail__title {
    max-width: 620px;
    font-size: var(--fs-h2-sm);
    font-weight: 300;
    line-height: 1.16;
    color: var(--color-cream);
  }
  .detail__summary {
    max-width: 560px;
    font-size: 16px;
    font-weight: 300;
    line-height: 1.72;
    color: rgb(239 226 196 / 0.7);
  }
  .detail__paras {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 560px;
  }

  .detail__meta {
    align-self: start;
    margin: 0;
    border-top: 1px solid rgb(239 226 196 / 0.14);
  }

  .detail__shots {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    padding: 0 var(--gutter) 88px;
  }

  .detail__foot {
    padding-top: 80px;
    border-top: 1px solid rgb(239 226 196 / 0.1);
  }
  .detail__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
  }

  @media (max-width: 860px) {
    .detail__intro {
      grid-template-columns: minmax(0, 1fr);
    }
    .detail__shots {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<style is:global>
  /* The paragraphs, meta rows and shots are built at runtime from the project
     data (see src/scripts/site.ts), so they never carry Astro's scoping
     attribute — these rules have to be global to reach them. */
  .detail__paras p {
    font-size: var(--fs-xs);
    font-weight: 300;
    line-height: 1.85;
    color: rgb(239 226 196 / 0.55);
  }

  .detail__meta > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding: 16px 0;
    border-bottom: 1px solid rgb(239 226 196 / 0.14);
  }
  .detail__meta dt {
    font-size: var(--fs-label-sm);
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgb(239 226 196 / 0.4);
  }
  .detail__meta dd {
    margin: 0;
    font-size: 14px;
    font-weight: 300;
    text-align: right;
    color: var(--color-cream);
  }

  .detail__shots figure {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
  }
  .detail__shots .media {
    aspect-ratio: 3 / 2;
  }
  .detail__shots img {
    filter: brightness(0.9);
  }
  .detail__shots figcaption {
    font-size: var(--fs-xs);
    font-weight: 300;
    line-height: 1.7;
    color: rgb(239 226 196 / 0.5);
  }
</style>
