---
import Logo from "./icons/Logo.astro";
import { COPY, FOUNDERS, INSTAGRAM } from "../data/copy";

const en = COPY.en;
const primary = FOUNDERS[0];

/* The full-screen menu lists About first, like the design's phone menu. */
const MENU = [
  { href: "#about", key: "navAbout", label: en.navAbout },
  { href: "#services", key: "navServices", label: en.navServices },
  { href: "#projects", key: "navProjects", label: en.navProjects },
  { href: "#process", key: "navProcess", label: en.navProcess },
] as const;
---

<header class="nav" id="site-nav">
  <a href="#top" class="nav__logo" aria-label="RE-LUX Construction — home">
    <Logo class="nav__logo-mark" />
  </a>

  <nav class="nav__menu" aria-label="Main">
    <a href="#services" data-i18n="navServices">Services</a>
    <a href="#projects" data-i18n="navProjects">Work</a>
    <a href="#about" data-i18n="navAbout">About</a>
    <a href="#process" data-i18n="navProcess">Process</a>
  </nav>

  <div class="nav__right">
    <div class="lang" role="group" aria-label="Language">
      <button type="button" class="lang__btn is-active" data-lang="en">EN</button>
      <span class="lang__sep" aria-hidden="true"></span>
      <button type="button" class="lang__btn" data-lang="es">ES</button>
    </div>
    <a href="#contact" class="btn btn--solid nav__cta" data-i18n="navQuote"
      >Get a Quote</a
    >
  </div>

  <button
    type="button"
    class="nav__burger"
    id="nav-burger"
    aria-controls="nav-sheet"
    aria-expanded="false"
  >
    <span id="nav-burger-label">{en.menuOpen}</span>
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path class="nav__burger-open" d="M4 8h16M4 16h16"></path>
      <path class="nav__burger-close" d="M6 6l12 12M18 6 6 18"></path>
    </svg>
  </button>
</header>

<!-- Full-screen menu for tablet and phone. Sits under the header, so the
     burger stays in place as the close button. -->
<div class="sheet" id="nav-sheet" hidden>
  <nav class="sheet__nav" aria-label="Main">
    {
      MENU.map((m, i) => (
        <a href={m.href}>
          <span data-i18n={m.key}>{m.label}</span>
          <span class="sheet__n">{String(i + 1).padStart(2, "0")}</span>
        </a>
      ))
    }
  </nav>

  <div class="sheet__foot">
    <div class="lang sheet__lang" role="group" aria-label="Language">
      <button type="button" class="lang__btn is-active" data-lang="en">EN</button>
      <span class="lang__sep" aria-hidden="true"></span>
      <button type="button" class="lang__btn" data-lang="es">ES</button>
    </div>
    <a href="#contact" class="btn btn--solid sheet__cta" data-i18n="navQuote"
      >Get a Quote</a
    >
    <div class="sheet__contact">
      <a href={`tel:${primary.tel}`}>{primary.phone}</a>
      <a href={INSTAGRAM.url} target="_blank" rel="noopener">{INSTAGRAM.handle}</a>
    </div>
  </div>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: 24px;
    /* The design's logo slot is what sets this height, not the mark itself */
    min-height: var(--header-h);
    padding: 14px 36px;
    background: linear-gradient(
      to bottom,
      rgb(6 5 4 / 0.94) 0%,
      rgb(6 5 4 / 0.78) 55%,
      rgb(6 5 4 / 0) 100%
    );
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  .nav__logo {
    justify-self: start;
    display: flex;
    align-items: center;
    /* The mark is a vector filled with currentColor */
    color: var(--color-cream);
  }
  .nav__logo:hover {
    color: var(--color-sand);
  }
  /* :global — the mark is injected with set:html, so it carries no scope attribute */
  .nav__logo :global(.nav__logo-mark) {
    display: block;
    width: var(--logo-w);
    height: auto;
  }

  .nav__menu {
    justify-self: center;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 28px;
  }
  .nav__menu > a {
    font-size: var(--fs-nav);
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgb(239 226 196 / 0.82);
  }
  .nav__menu > a:hover {
    color: var(--color-cream);
  }

  .nav__right {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .lang {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .lang__btn {
    appearance: none;
    border: 0;
    background: transparent;
    padding: 0;
    cursor: pointer;
    font-size: var(--fs-nav);
    font-weight: 400;
    letter-spacing: 0.2em;
    line-height: 1;
    color: var(--color-stone);
    transition: color 0.3s ease;
  }
  .lang__btn.is-active {
    font-weight: 500;
    color: var(--color-cream);
  }
  .lang__sep {
    width: 1px;
    height: 11px;
    background: rgb(239 226 196 / 0.28);
  }

  /* The design pins pill buttons to 10px; .btn's fluid size drifts above it */
  .nav__cta,
  .sheet__cta {
    font-size: 10px;
  }
  .nav__cta:hover {
    color: var(--color-ink);
  }

  /* ── "Menu" pill, shown only below the desktop layout ── */
  .nav__burger {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 12px;
    height: 44px;
    padding: 0 20px;
    border: 1px solid rgb(239 226 196 / 0.3);
    border-radius: 999px;
    background: transparent;
    color: var(--color-cream);
    cursor: pointer;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.24em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .nav__burger svg {
    display: block;
  }
  .nav__burger-close,
  .nav__burger[aria-expanded="true"] .nav__burger-open {
    display: none;
  }
  .nav__burger[aria-expanded="true"] .nav__burger-close {
    display: inline;
  }

  /* ── Full-screen sheet ── */
  .sheet {
    position: fixed;
    inset: 0;
    z-index: 99;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    padding: 120px 28px 40px;
    overflow-y: auto;
    background: var(--color-ink);
  }
  .sheet[hidden] {
    display: none;
  }
  .sheet__nav {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgb(239 226 196 / 0.1);
  }
  .sheet__nav > a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 0;
    border-bottom: 1px solid rgb(239 226 196 / 0.1);
    font-size: 26px;
    font-weight: 300;
    color: var(--color-cream);
  }
  .sheet__n {
    font-size: 10px;
    letter-spacing: 0.3em;
    color: var(--color-stone);
  }
  .sheet__foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }
  .sheet__lang {
    gap: 14px;
  }
  .sheet__contact {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sheet__contact a {
    font-size: 15px;
    font-weight: 300;
    color: rgb(239 226 196 / 0.66);
  }

  @media (max-width: 1080px) {
    .nav {
      grid-template-columns: 1fr auto;
      padding: 10px 24px;
    }
    .nav__menu,
    .nav__right {
      display: none;
    }
    .nav__burger {
      display: inline-flex;
    }
  }
  @media (max-width: 720px) {
    .nav {
      padding: 8px 16px;
    }
  }
  /* Nothing to open once the desktop nav is back */
  @media (min-width: 1081px) {
    .sheet {
      display: none;
    }
  }
</style>
