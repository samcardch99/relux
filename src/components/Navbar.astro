---
import Logo from "./icons/Logo.astro";
import { COPY, FOUNDERS, INSTAGRAM } from "../data/copy";

const en = COPY.en;
const primary = FOUNDERS[0];

/* The full-screen menu lists About first, like the design's phone menu. */
const MENU = [
  { href: "#about", key: "navAbout", label: en.navAbout },
  { href: "#services", key: "navServices", label: en.navServices },
  { href: "#projects", key: "navProjects", label: en.navProjects },
  { href: "#process", key: "navProcess", label: en.navProcess },
] as const;
---

<header class="nav" id="site-nav">
  <a href="#top" class="nav__logo" aria-label="RE-LUX Construction — home">
    <Logo class="nav__logo-mark" />
  </a>

  <nav class="nav__menu" aria-label="Main">
    <a href="#services" data-i18n="navServices">Services</a>
    <a href="#projects" data-i18n="navProjects">Work</a>
    <a href="#about" data-i18n="navAbout">About</a>
    <a href="#process" data-i18n="navProcess">Process</a>
  </nav>

  <div class="nav__right">
    <div class="lang" role="group" aria-label="Language">
      <button type="button" class="lang__btn is-active" data-lang="en">EN</button>
      <span class="lang__sep" aria-hidden="true"></span>
      <button type="button" class="lang__btn" data-lang="es">ES</button>
    </div>
    <a href="#contact" class="btn btn--solid nav__cta" data-i18n="navQuote"
      >Get a Quote</a
    >
  </div>

  <button
    type="button"
    class="nav__burger"
    id="nav-burger"
    aria-controls="nav-sheet"
    aria-expanded="false"
  >
    <span id="nav-burger-label">{en.menuOpen}</span>
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path class="nav__burger-l1" d="M4 8h16"></path>
      <path class="nav__burger-l2" d="M4 16h16"></path>
    </svg>
  </button>
</header>

<!-- Full-screen menu for tablet and phone. Sits under the header, so the
     burger stays in place as the close button. -->
<div class="sheet" id="nav-sheet" hidden>
  <span class="sheet__edge" aria-hidden="true"></span>
  <nav class="sheet__nav" aria-label="Main">
    {
      MENU.map((m, i) => (
        <a href={m.href} style={`--i:${i}`}>
          <span class="sheet__mask">
            <span class="sheet__label" data-i18n={m.key}>{m.label}</span>
          </span>
          <span class="sheet__n">{String(i + 1).padStart(2, "0")}</span>
        </a>
      ))
    }
  </nav>

  <div class="sheet__foot">
    <div class="lang sheet__lang" role="group" aria-label="Language">
      <button type="button" class="lang__btn is-active" data-lang="en">EN</button>
      <span class="lang__sep" aria-hidden="true"></span>
      <button type="button" class="lang__btn" data-lang="es">ES</button>
    </div>
    <a href="#contact" class="btn btn--solid sheet__cta" data-i18n="navQuote"
      >Get a Quote</a
    >
    <div class="sheet__contact">
      <a href={`tel:${primary.tel}`}>{primary.phone}</a>
      <a href={INSTAGRAM.url} target="_blank" rel="noopener">{INSTAGRAM.handle}</a>
    </div>
  </div>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: 24px;
    /* The design's logo slot is what sets this height, not the mark itself */
    min-height: var(--header-h);
    padding: 14px 36px;
    background: linear-gradient(
      to bottom,
      rgb(6 5 4 / 0.94) 0%,
      rgb(6 5 4 / 0.78) 55%,
      rgb(6 5 4 / 0) 100%
    );
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  .nav__logo {
    justify-self: start;
    display: flex;
    align-items: center;
    /* The mark is a vector filled with currentColor */
    color: var(--color-cream);
  }
  .nav__logo:hover {
    color: var(--color-sand);
  }
  /* :global — the mark is injected with set:html, so it carries no scope attribute */
  .nav__logo :global(.nav__logo-mark) {
    display: block;
    width: var(--logo-w);
    height: auto;
  }

  .nav__menu {
    justify-self: center;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 28px;
  }
  .nav__menu > a {
    font-size: var(--fs-nav);
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgb(239 226 196 / 0.82);
  }
  .nav__menu > a:hover {
    color: var(--color-cream);
  }

  .nav__right {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .lang {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .lang__btn {
    appearance: none;
    border: 0;
    background: transparent;
    padding: 0;
    cursor: pointer;
    font-size: var(--fs-nav);
    font-weight: 400;
    letter-spacing: 0.2em;
    line-height: 1;
    color: var(--color-stone);
    transition: color 0.3s ease;
  }
  .lang__btn.is-active {
    font-weight: 500;
    color: var(--color-cream);
  }
  .lang__sep {
    width: 1px;
    height: 11px;
    background: rgb(239 226 196 / 0.28);
  }

  /* The design pins pill buttons to 10px; .btn's fluid size drifts above it */
  .nav__cta,
  .sheet__cta {
    font-size: 10px;
  }
  .nav__cta:hover {
    color: var(--color-ink);
  }

  /* ── "Menu" pill, shown only below the desktop layout ── */
  .nav__burger {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 12px;
    height: 44px;
    padding: 0 20px;
    border: 1px solid rgb(239 226 196 / 0.3);
    border-radius: 999px;
    background: transparent;
    color: var(--color-cream);
    cursor: pointer;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.24em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .nav__burger > span {
    display: inline-block;
  }
  .nav__burger svg {
    display: block;
    overflow: visible;
  }
  /* The two bars fold into an X around their own centres */
  .nav__burger svg path {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.6s cubic-bezier(0.76, 0, 0.24, 1);
  }
  .nav__burger[aria-expanded="true"] .nav__burger-l1 {
    transform: translateY(4px) rotate(45deg) scaleX(0.85);
  }
  .nav__burger[aria-expanded="true"] .nav__burger-l2 {
    transform: translateY(-4px) rotate(-45deg) scaleX(0.85);
  }

  /* ── Full-screen sheet ──
     Opening: the ink curtain drops behind a gold hairline, the dividers
     draw in gold and cool to the usual hairline, each label rises out of
     its own mask and the indexes settle their tracking, row by row; the
     footer comes last. Closing gathers the content first, then lifts the
     curtain. The script toggles .is-open and keeps the sheet unhidden
     until the curtain is up. */
  .sheet {
    --ease-curtain: cubic-bezier(0.76, 0, 0.24, 1);
    --ease-rise: cubic-bezier(0.22, 1, 0.36, 1);
    position: fixed;
    inset: 0;
    z-index: 99;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    padding: 120px 28px 40px;
    overflow-y: auto;
    background: var(--color-ink);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.7s var(--ease-curtain) 0.22s;
  }
  .sheet.is-open {
    clip-path: inset(0 0 0 0);
    transition: clip-path 0.9s var(--ease-curtain);
  }
  .sheet[hidden] {
    display: none;
  }

  .sheet__edge {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      rgb(201 164 92 / 0) 0%,
      rgb(201 164 92 / 0.9) 30%,
      rgb(232 213 172 / 1) 50%,
      rgb(201 164 92 / 0.9) 70%,
      rgb(201 164 92 / 0) 100%
    );
    box-shadow: 0 0 14px 1px rgb(201 164 92 / 0.45);
    opacity: 0;
    pointer-events: none;
  }
  .sheet.is-open .sheet__edge {
    animation: sheet-edge 0.9s var(--ease-curtain) both;
  }
  @keyframes sheet-edge {
    0% {
      opacity: 1;
      top: 0;
    }
    80% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      top: calc(100% - 1px);
    }
  }

  .sheet__nav {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  /* Hairlines are drawn, not bordered, so they can sweep in */
  .sheet__nav::before,
  .sheet__nav > a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: rgb(239 226 196 / 0.1);
    transform: scaleX(0);
    transform-origin: left;
    transition:
      transform 0.35s ease,
      background 0.35s ease;
  }
  .sheet__nav::before {
    top: 0;
  }
  .sheet__nav > a::after {
    bottom: 0;
  }
  .sheet.is-open .sheet__nav::before,
  .sheet.is-open .sheet__nav > a::after {
    transform: scaleX(1);
    animation: sheet-rule 1.6s ease both;
    transition: transform 1s var(--ease-rise);
  }
  .sheet.is-open .sheet__nav::before {
    transition-delay: 0.3s;
    animation-delay: 0.3s;
  }
  .sheet.is-open .sheet__nav > a::after {
    transition-delay: calc(0.38s + var(--i) * 0.08s);
    animation-delay: calc(0.38s + var(--i) * 0.08s);
  }
  @keyframes sheet-rule {
    0%,
    35% {
      background: rgb(201 164 92 / 0.7);
    }
    100% {
      background: rgb(239 226 196 / 0.1);
    }
  }

  .sheet__nav > a {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 0;
    font-size: 26px;
    font-weight: 300;
    color: var(--color-cream);
  }
  .sheet__mask {
    display: block;
    overflow: hidden;
    /* room for descenders inside the mask */
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }
  .sheet__label {
    display: block;
    transform: translateY(110%);
    transition: transform 0.3s ease;
  }
  .sheet.is-open .sheet__label {
    transform: translateY(0);
    transition: transform 1s var(--ease-rise) calc(0.42s + var(--i) * 0.08s);
  }

  .sheet__n {
    font-size: 10px;
    letter-spacing: 0.7em;
    color: var(--color-stone);
    opacity: 0;
    transition:
      opacity 0.25s ease,
      letter-spacing 0.25s ease;
  }
  .sheet.is-open .sheet__n {
    opacity: 1;
    letter-spacing: 0.3em;
    transition:
      opacity 0.9s ease calc(0.6s + var(--i) * 0.08s),
      letter-spacing 1.2s var(--ease-rise) calc(0.6s + var(--i) * 0.08s);
  }

  .sheet__foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }
  .sheet__foot > * {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }
  .sheet.is-open .sheet__foot > * {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.8s ease,
      transform 0.9s var(--ease-rise);
  }
  .sheet.is-open .sheet__foot > :nth-child(1) {
    transition-delay: 0.85s;
  }
  .sheet.is-open .sheet__foot > :nth-child(2) {
    transition-delay: 0.93s;
  }
  .sheet.is-open .sheet__foot > :nth-child(3) {
    transition-delay: 1.01s;
  }
  .sheet__lang {
    gap: 14px;
  }
  .sheet__contact {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sheet__contact a {
    font-size: 15px;
    font-weight: 300;
    color: rgb(239 226 196 / 0.66);
  }

  /* The global rule shortens durations; drop the staggers too */
  @media (prefers-reduced-motion: reduce) {
    .sheet,
    .sheet *,
    .sheet *::after,
    .sheet__nav::before {
      transition-delay: 0s !important;
      animation-delay: 0s !important;
    }
  }

  @media (max-width: 1080px) {
    .nav {
      grid-template-columns: 1fr auto;
      padding: 10px 24px;
    }
    .nav__menu,
    .nav__right {
      display: none;
    }
    .nav__burger {
      display: inline-flex;
    }
  }
  @media (max-width: 720px) {
    .nav {
      padding: 8px 16px;
    }
  }
  /* Nothing to open once the desktop nav is back */
  @media (min-width: 1081px) {
    .sheet {
      display: none;
    }
  }
</style>
