---
import Logo from "./icons/Logo.astro";
---

<header class="nav" id="site-nav">
  <a href="#top" class="nav__logo" aria-label="RE-LUX Construction — home">
    <Logo class="nav__logo-mark" />
  </a>

  <button
    type="button"
    class="nav__burger"
    id="nav-burger"
    aria-controls="nav-menu"
    aria-expanded="false"
    aria-label="Menu"
  >
    <span></span><span></span>
  </button>

  <nav class="nav__menu" id="nav-menu" aria-label="Main">
    <a href="#services" data-i18n="navServices">Services</a>
    <a href="#projects" data-i18n="navProjects">Work</a>
    <a href="#about" data-i18n="navAbout">About</a>
    <a href="#process" data-i18n="navProcess">Process</a>
    <a href="#contact" class="btn btn--solid nav__menu-cta" data-i18n="navQuote"
      >Get a Quote</a
    >
  </nav>

  <div class="nav__right">
    <div class="lang" role="group" aria-label="Language">
      <button type="button" class="lang__btn is-active" data-lang="en">EN</button>
      <span class="lang__sep" aria-hidden="true"></span>
      <button type="button" class="lang__btn" data-lang="es">ES</button>
    </div>
    <a href="#contact" class="btn btn--solid nav__cta" data-i18n="navQuote"
      >Get a Quote</a
    >
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    /* row-gap stays 0 so the collapsed mobile menu adds no dead height */
    column-gap: 24px;
    row-gap: 0;
    /* The design's logo slot is what sets this height, not the mark itself */
    min-height: var(--header-h);
    padding: 14px 36px;
    background: linear-gradient(
      to bottom,
      rgb(6 5 4 / 0.94) 0%,
      rgb(6 5 4 / 0.78) 55%,
      rgb(6 5 4 / 0) 100%
    );
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  .nav__logo {
    justify-self: start;
    display: flex;
    align-items: center;
    /* The mark is a vector filled with currentColor */
    color: var(--color-cream);
  }
  .nav__logo:hover {
    color: var(--color-sand);
  }
  /* :global — the mark is injected with set:html, so it carries no scope attribute */
  .nav__logo :global(.nav__logo-mark) {
    display: block;
    width: var(--logo-w);
    height: auto;
  }

  .nav__menu {
    justify-self: center;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 28px;
  }
  /* :not(.btn) so the in-menu quote pill keeps its own dark-on-sand colour */
  .nav__menu > a:not(.btn) {
    font-size: var(--fs-nav);
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgb(239 226 196 / 0.82);
  }
  .nav__menu > a:not(.btn):hover {
    color: var(--color-cream);
  }
  /* The in-menu quote button only appears in the mobile panel */
  .nav__menu-cta {
    display: none;
  }

  .nav__right {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .lang {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .lang__btn {
    appearance: none;
    border: 0;
    background: transparent;
    padding: 0;
    cursor: pointer;
    font-size: var(--fs-nav);
    font-weight: 400;
    letter-spacing: 0.2em;
    line-height: 1;
    color: var(--color-stone);
    transition: color 0.3s ease;
  }
  .lang__btn.is-active {
    font-weight: 500;
    color: var(--color-cream);
  }
  .lang__sep {
    width: 1px;
    height: 11px;
    background: rgb(239 226 196 / 0.28);
  }

  /* The design pins pill buttons to 10px; .btn's fluid size drifts above it */
  .nav__cta,
  .nav__menu-cta {
    font-size: 10px;
  }
  .nav__cta:hover {
    color: var(--color-ink);
  }

  /* ── Burger, shown only on narrow viewports ── */
  .nav__burger {
    display: none;
    justify-self: end;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid rgb(239 226 196 / 0.3);
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    place-content: center;
    gap: 5px;
  }
  .nav__burger span {
    display: block;
    width: 16px;
    height: 1px;
    background: var(--color-cream);
    transition: transform 0.3s ease;
  }
  .nav__burger[aria-expanded="true"] span:first-child {
    transform: translateY(3px) rotate(45deg);
  }
  .nav__burger[aria-expanded="true"] span:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  @media (max-width: 1080px) {
    .nav {
      grid-template-columns: 1fr auto auto;
    }
    .nav__burger {
      display: grid;
      order: 3;
    }
    .nav__right {
      order: 2;
    }
    .nav__cta {
      display: none;
    }
    .nav__menu {
      order: 4;
      grid-column: 1 / -1;
      justify-self: stretch;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .nav__menu.is-open {
      max-height: 60vh;
      margin-top: 14px;
      overflow-y: auto;
      /* The header gradient has faded out by this point, so the panel
         carries its own background to stay legible over the hero photo. */
      background: var(--color-ink);
      box-shadow: 0 18px 30px rgb(6 5 4 / 0.6);
    }
    .nav__menu > a {
      padding: 16px 4px;
      border-bottom: 1px solid rgb(239 226 196 / 0.1);
    }
    .nav__menu-cta {
      display: inline-flex;
      align-self: flex-start;
      margin: 20px 0 8px;
      border-bottom: 0;
    }
  }
</style>
