---
import { COPY, REVIEWS_URL } from "../data/copy";
import data from "../data/reviews.json";
import ArrowUpRight from "./icons/ArrowUpRight.astro";

const en = COPY.en;

/**
 * Las reseñas vienen de src/data/reviews.json, que escribe
 * scripts/fetch-reviews.mjs desde la Places API en cada build. Si esta vacio la
 * seccion no se renderiza: mejor no enseñar nada que enseñar reseñas inventadas.
 */
const reviews = data.reviews ?? [];
const rating = data.rating;
const total = data.total ?? 0;
const mapsUrl = data.mapsUrl || REVIEWS_URL;

const first = reviews[0];
const nota = rating != null ? rating.toFixed(1) : null;
// Estrellas llenas segun la nota real, no cinco siempre.
const llenas = rating != null ? Math.round(rating) : 0;
const pad = (n: number) => String(n).padStart(2, "0");

/** "hace 3 meses" se arma desde COPY, para que cambie con el idioma. */
const antiguedad = (m: number, t: typeof en) =>
  m === 1 ? t.revAgo1 : t.revAgo.replace("{n}", String(m));

/**
 * Las reseñas reales van de 73 a 642 caracteres. A 30px la mas larga desborda
 * el bloque, asi que el tamaño baja por tramos en vez de recortar el texto:
 * cortar lo que escribio alguien es cambiar lo que dijo.
 */
const tramo = (n: number) => (n > 460 ? "is-xl" : n > 260 ? "is-l" : "");
---

{
  reviews.length > 0 && (
    <section class="reviews" id="reviews" data-reviews={JSON.stringify(reviews)}>
      <div class="reviews__card">
        <aside class="reviews__score">
          <div class="reviews__score-top">
            <span class="kicker reviews__kicker" data-i18n="revKicker">
              {en.revKicker}
            </span>
            <span class="reviews__num">{nota}</span>
            <span class="reviews__stars" aria-label={`${nota} out of 5`} role="img">
              {[0, 1, 2, 3, 4].map((i) => (
                <span class={i < llenas ? "" : "is-empty"}>★</span>
              ))}
            </span>
            <p class="reviews__basis" data-i18n="revBasis" data-n={total}>
              {en.revBasis.replace("{n}", String(total))}
            </p>
          </div>

          <a class="btn btn--ghost reviews__link" href={mapsUrl} target="_blank" rel="noopener">
            <span data-i18n="revLink">{en.revLink}</span>
            <ArrowUpRight />
          </a>
        </aside>

        <figure class="reviews__quote">
          <span class="reviews__mark" aria-hidden="true">
            “
          </span>

          <div class="reviews__main">
            <blockquote
              class:list={["reviews__text", tramo(first.text.length)]}
              id="review-text"
              lang={first.lang}
              aria-live="polite"
            >
              {first.text}
            </blockquote>

            <figcaption class="reviews__who">
              {first.avatar ? (
                <img
                  class="reviews__avatar"
                  id="review-avatar"
                  src={first.avatar}
                  alt=""
                  width="56"
                  height="56"
                  loading="lazy"
                  referrerpolicy="no-referrer"
                />
              ) : (
                <span class="reviews__avatar" id="review-avatar" aria-hidden="true" />
              )}
              <span class="reviews__id">
                <span class="reviews__name" id="review-name">
                  {first.name}
                </span>
                <span class="reviews__meta">
                  <span id="review-when">{antiguedad(first.monthsAgo, en)}</span>
                  — Google
                </span>
              </span>
            </figcaption>
          </div>

          <div class="reviews__nav">
            {/* One bar per review: it fills while that review is on screen */}
            <div class="reviews__bars">
              {reviews.map((_, n) => (
                <button
                  type="button"
                  class="reviews__bar"
                  data-rev-go={n}
                  aria-label={`Review ${pad(n + 1)}`}
                  aria-controls="review-text"
                >
                  <span class="reviews__bar-track">
                    <span class="reviews__bar-fill" data-rev-bar={n} />
                  </span>
                </button>
              ))}
            </div>
            <div class="reviews__arrows">
              <button
                type="button"
                class="reviews__arrow"
                id="review-prev"
                aria-label="Previous review"
                aria-controls="review-text"
              >
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M19 12H5" />
                  <path d="m11 6-6 6 6 6" />
                </svg>
              </button>
              <button
                type="button"
                class="reviews__arrow"
                id="review-next"
                aria-label="Next review"
                aria-controls="review-text"
              >
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14" />
                  <path d="m13 6 6 6-6 6" />
                </svg>
              </button>
            </div>
          </div>
        </figure>
      </div>
    </section>
  )
}

<style>
  .reviews {
    padding: 120px var(--gutter);
    background: var(--color-ink);
  }

  .reviews__card {
    display: grid;
    grid-template-columns: minmax(300px, 0.8fr) minmax(0, 2fr);
    min-height: 520px;
    background: var(--color-ink-3);
    border: 1px solid rgb(239 226 196 / 0.08);
  }

  .reviews__score {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    padding: 64px 48px 56px 56px;
    border-right: 1px solid rgb(239 226 196 / 0.08);
  }
  .reviews__score-top {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .reviews__kicker {
    letter-spacing: 0.36em;
  }
  .reviews__num {
    font-size: 104px;
    font-weight: 200;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--color-cream);
  }
  .reviews__stars {
    display: flex;
    gap: 5px;
    font-size: 16px;
    line-height: 1;
    color: var(--color-sand);
  }
  .reviews__stars .is-empty {
    color: rgb(239 226 196 / 0.22);
  }
  .reviews__basis {
    max-width: 230px;
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: 300;
    line-height: 1.6;
    color: rgb(239 226 196 / 0.55);
  }
  .reviews__link {
    align-self: flex-start;
  }
  .reviews__link:hover {
    border-color: var(--color-sand);
    color: var(--color-sand);
  }

  .reviews__quote {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 48px;
    min-width: 0;
    margin: 0;
    padding: 64px 64px 56px;
  }
  .reviews__mark {
    height: 40px;
    font-size: 120px;
    font-weight: 200;
    line-height: 0.5;
    color: var(--color-stone);
  }
  .reviews__main {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  /* The design sets 32px for one-line placeholder quotes. The real reviews run
     from 73 to 642 characters, so the body keeps the smaller sizes tuned for
     them and steps down by length instead of cutting anyone's words. */
  .reviews__text {
    max-width: 860px;
    /* Reserved for the longest review in the batch (measured: 223px at 18px),
       so the card does not jump between a short and a long one. Re-measure if
       the reviews change. */
    min-height: 228px;
    margin: 0;
    font-size: 26px;
    font-weight: 300;
    line-height: 1.45;
    color: var(--color-cream);
    text-wrap: pretty;
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }
  .reviews__text.is-l {
    font-size: 21px;
  }
  .reviews__text.is-xl {
    font-size: 18px;
    line-height: 1.55;
  }
  /* Set for one frame by the script, then released so the text fades up */
  .reviews__text.is-enter {
    opacity: 0;
    transform: translateY(10px);
    transition: none;
  }

  .reviews__who {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .reviews__avatar {
    width: 56px;
    height: 56px;
    flex: none;
    border-radius: 999px;
    border: 1px solid rgb(239 226 196 / 0.18);
    background-color: rgb(239 226 196 / 0.04);
    object-fit: cover;
  }
  .reviews__id {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .reviews__name {
    font-size: 16px;
    font-weight: 400;
    color: var(--color-cream);
  }
  .reviews__meta {
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-stone);
  }

  .reviews__nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .reviews__bars {
    flex: 1;
    display: flex;
    gap: 10px;
  }
  .reviews__bar {
    flex: 1;
    display: flex;
    align-items: center;
    height: 22px;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .reviews__bar-track {
    position: relative;
    display: block;
    width: 100%;
    height: 2px;
    overflow: hidden;
    background: rgb(239 226 196 / 0.16);
  }
  .reviews__bar-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0%;
    background: var(--color-sand);
  }
  .reviews__arrows {
    display: flex;
    gap: 10px;
  }
  .reviews__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: transparent;
    border: 1px solid rgb(239 226 196 / 0.3);
    color: var(--color-cream);
    cursor: none;
    transition:
      border-color 0.35s ease,
      color 0.35s ease;
  }
  .reviews__arrow:hover {
    border-color: var(--color-sand);
    color: var(--color-sand);
  }
  .reviews__arrow:focus-visible,
  .reviews__bar:focus-visible {
    outline: 1px solid var(--color-sand);
    outline-offset: 3px;
  }

  @media (max-width: 1080px) {
    .reviews__card {
      grid-template-columns: minmax(0, 1fr);
    }
    /* The score panel turns into a band across the top */
    .reviews__score {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-end;
      padding: 48px 40px;
      border-right: 0;
      border-bottom: 1px solid rgb(239 226 196 / 0.08);
    }
    .reviews__quote {
      padding: 48px 40px;
    }
    .reviews__num {
      font-size: 80px;
    }
    .reviews__text {
      min-height: 0;
      font-size: 22px;
    }
    .reviews__text.is-l {
      font-size: 19px;
    }
    .reviews__text.is-xl {
      font-size: 17px;
    }
  }

  @media (max-width: 720px) {
    .reviews {
      padding-top: 80px;
      padding-bottom: 80px;
    }
    .reviews__card {
      min-height: 0;
    }
    .reviews__score,
    .reviews__quote {
      padding: 36px 24px;
    }
    .reviews__num {
      font-size: 64px;
    }
    .reviews__text {
      font-size: 19px;
    }
    .reviews__text.is-l {
      font-size: 17px;
    }
    .reviews__text.is-xl {
      font-size: 16px;
    }
    .reviews__nav {
      gap: 20px;
    }
  }
</style>
