---
import { responsive, SIZES } from "../data/images";
import { COPY, langOfPath, projectPath, type PROJECTS } from "../data/copy";
import ArrowRight from "./icons/ArrowRight.astro";

interface Props {
  project: (typeof PROJECTS)[number];
  /** On screen when the page loads: fetch now, the first one before anything else. */
  priority?: "high" | "auto";
}

const { project, priority } = Astro.props;
const en = COPY.en;
---

<a href={projectPath(project.i, langOfPath(Astro.url.pathname))} class="pcard" data-project={project.i}>
  <div class="media pcard__media">
    <img
      {...responsive(project.img, SIZES.card)}
      alt={en[project.titleKey]}
      data-i18n-alt={project.titleKey}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority === "high" ? "high" : undefined}
      style={"focus" in project ? `object-position:${project.focus}` : undefined}
    />
  </div>
  <div class="pcard__body">
    <span class="kicker" data-i18n={project.tagKey}>{en[project.tagKey]}</span>
    <h3 class="pcard__title" data-i18n={project.titleKey}>
      {en[project.titleKey]}
    </h3>
    <span class="pcard__cue">
      <span data-i18n="cardOpen">View project</span>
      <ArrowRight />
    </span>
  </div>
</a>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .pcard__media {
    aspect-ratio: 4 / 5;
  }
  /* Hover: the photo brightens and slowly zooms, the text lifts a little */
  .pcard__media > img {
    filter: brightness(0.82);
    transition:
      transform 0.9s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.6s ease;
  }
  .pcard:hover .pcard__media > img,
  .pcard:focus-visible .pcard__media > img {
    transform: scale(1.07);
    filter: brightness(1);
  }
  /* Touch screens never hover, so they get the photo at full brightness */
  @media (hover: none) {
    .pcard__media > img {
      filter: none;
    }
  }

  .pcard__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pcard:hover .pcard__body,
  .pcard:focus-visible .pcard__body {
    transform: translateY(-4px);
  }

  .pcard__title {
    font-size: var(--fs-h3-sm);
    font-weight: 400;
    line-height: 1.3;
    color: var(--color-cream);
  }

  .pcard__cue {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    font-size: var(--fs-label-sm);
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color-stone);
    transition: color 0.35s ease;
  }
  .pcard:hover .pcard__cue,
  .pcard:focus-visible .pcard__cue {
    color: var(--color-cream);
  }

  .pcard:focus-visible {
    outline: 1px solid var(--color-stone);
    outline-offset: 6px;
  }
</style>
