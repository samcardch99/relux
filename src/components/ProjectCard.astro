---
import { COPY, type PROJECTS } from "../data/copy";
import ArrowRight from "./icons/ArrowRight.astro";

interface Props {
  project: (typeof PROJECTS)[number];
}

const { project } = Astro.props;
const en = COPY.en;
---

<button type="button" class="pcard" data-project={project.i}>
  <div class="media pcard__media">
    <img
      src={project.img}
      alt=""
      loading="lazy"
      style={"focus" in project ? `object-position:${project.focus}` : undefined}
    />
  </div>
  <div class="pcard__body">
    <span class="kicker" data-i18n={project.tagKey}>{en[project.tagKey]}</span>
    <h3 class="pcard__title" data-i18n={project.titleKey}>
      {en[project.titleKey]}
    </h3>
    <span class="pcard__cue">
      <span data-i18n="cardOpen">View project</span>
      <ArrowRight />
    </span>
  </div>
</button>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .pcard__media {
    aspect-ratio: 4 / 5;
  }
  .pcard__media > img {
    filter: brightness(0.84);
    transition: filter 0.5s ease;
  }
  .pcard:hover .pcard__media > img,
  .pcard:focus-visible .pcard__media > img {
    filter: brightness(0.98);
  }

  .pcard__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .pcard__title {
    font-size: var(--fs-h3-sm);
    font-weight: 400;
    line-height: 1.3;
    color: var(--color-cream);
  }

  .pcard__cue {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    font-size: var(--fs-label-sm);
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color-stone);
    transition: color 0.35s ease;
  }
  .pcard:hover .pcard__cue,
  .pcard:focus-visible .pcard__cue {
    color: var(--color-cream);
  }

  .pcard:focus-visible {
    outline: 1px solid var(--color-stone);
    outline-offset: 6px;
  }
</style>
