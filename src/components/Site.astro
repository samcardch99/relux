---
/**
 * Every route renders this. The homepage carries the whole one-page site with
 * the full-screen views closed; a view's own address (`view`, plus `project`
 * for a detail) carries only that view, open, so each page has content of its
 * own. Opening another view from there, or closing this one, loads its page
 * (see site.ts).
 */
import Layout from "../layouts/Layout.astro";
import Cursor from "./Cursor.astro";
import Navbar from "./Navbar.astro";
import Hero from "./Hero.astro";
import Story from "./Story.astro";
import Services from "./Services.astro";
import Materials from "./Materials.astro";
import Projects from "./Projects.astro";
import Process from "./Process.astro";
import Reviews from "./Reviews.astro";
import CTA from "./CTA.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import WorkView from "./views/WorkView.astro";
import AboutView from "./views/AboutView.astro";
import ProcessView from "./views/ProcessView.astro";
import DetailView from "./views/DetailView.astro";
import ProjectLightbox from "./ProjectLightbox.astro";

interface Props {
  view?: "work" | "about" | "process" | "detail";
  project?: number;
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: object[];
}

const { view, project, title, description, image, jsonLd } = Astro.props;
const home = !view;
/** The work grid opens projects in place, so its page keeps the detail view. */
const withDetail = home || view === "work" || view === "detail";
---

<Layout title={title} description={description} image={image} locked={!home} jsonLd={jsonLd}>
  <Cursor />
  <Navbar />

  {
    home && (
      <>
        <main>
          <Hero />
          <Story />
          <Services />
          <Materials />
          <Projects />
          <Process />
          <Reviews />
          <CTA />
          <Contact />
        </main>

        <Footer />
      </>
    )
  }

  <!-- Full-screen views, opened from the grid and the About / Process buttons -->
  {(home || view === "work") && <WorkView open={view === "work"} />}
  {(home || view === "about") && <AboutView open={view === "about"} />}
  {(home || view === "process") && <ProcessView open={view === "process"} />}
  {withDetail && <DetailView index={view === "detail" ? project : undefined} />}
  {withDetail && <ProjectLightbox />}
</Layout>
