---
/**
 * Every route renders this. The homepage carries the whole one-page site with
 * the full-screen views closed; a view's own address (`view`, plus `project`
 * for a detail) carries only that view, open, so each page has content of its
 * own. Opening another view from there, or closing this one, loads its page
 * (see site.ts).
 */
import Layout from "../layouts/Layout.astro";
import Cursor from "./Cursor.astro";
import Navbar from "./Navbar.astro";
import WhatsApp from "./WhatsApp.astro";
import Hero from "./Hero.astro";
import Story from "./Story.astro";
import Family from "./Family.astro";
import Workshop from "./Workshop.astro";
import Cases from "./Cases.astro";
import Brands from "./Brands.astro";
import Services from "./Services.astro";
import Materials from "./Materials.astro";
import Projects from "./Projects.astro";
import Process from "./Process.astro";
import Reviews from "./Reviews.astro";
import CTA from "./CTA.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import WorkView from "./views/WorkView.astro";
import AboutView from "./views/AboutView.astro";
import ProcessView from "./views/ProcessView.astro";
import DetailView from "./views/DetailView.astro";
import ProjectLightbox from "./ProjectLightbox.astro";

interface Props {
  view?: "work" | "about" | "process" | "detail";
  project?: number;
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: object[];
}

const { view, project, title, description, image, jsonLd } = Astro.props;
const home = !view;
/** The work grid opens projects in place, so its page keeps the detail view. */
const withDetail = home || view === "work" || view === "detail";
/** At its own address the view is the page's main content; on the homepage the
 *  views are overlays beside its <main>. `data-standalone` keeps site.ts from
 *  taking this one for the homepage's. */
const Views = home ? Fragment : "main";
const viewsAttrs = home ? {} : { "data-standalone": "" };
---

<Layout
  title={title}
  description={description}
  image={image}
  locked={!home}
  jsonLd={jsonLd}
  ogType={view === "detail" ? "article" : "website"}
>
  <Cursor />
  <Navbar />
  <WhatsApp />

  {
    home && (
      <>
        <main>
          <Hero />
          <Story />
          <Family />
          <Services />
          <Materials />
          <Workshop />
          <Projects />
          <Cases />
          <Brands />
          <Process />
          <Reviews />
          <CTA />
          <Contact />
        </main>

        <Footer />
      </>
    )
  }

  <!-- Full-screen views, opened from the grid and the About / Process buttons -->
  <Views {...viewsAttrs}>
    {(home || view === "work") && <WorkView open={view === "work"} shareContact={home} />}
    {(home || view === "about") && <AboutView open={view === "about"} shareContact={home} />}
    {(home || view === "process") && <ProcessView open={view === "process"} shareContact={home} />}
    {withDetail && <DetailView index={view === "detail" ? project : undefined} shareContact={view !== "detail"} />}
  </Views>
  {withDetail && <ProjectLightbox />}
</Layout>
