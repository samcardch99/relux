---
import { COPY, FOUNDERS, INSTAGRAM } from "../data/copy";

const en = COPY.en;
const primary = FOUNDERS[0];
---

<footer class="footer">
  <span class="footer__copy" data-i18n="footerCopy">{en.footerCopy}</span>

  <nav class="footer__links" aria-label="Footer">
    <a href="#top" data-i18n="footerPrivacy">Privacy</a>
    <a href={INSTAGRAM.url} target="_blank" rel="noopener">Instagram</a>
    <a href={`tel:${primary.tel}`}>{primary.phone}</a>
  </nav>
</footer>

<style>
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px 32px;
    margin-top: 96px;
    padding: 26px var(--gutter) 30px;
    border-top: 1px solid rgb(239 226 196 / 0.1);
    background: var(--color-ink);
  }

  .footer__copy {
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.06em;
    color: rgb(239 226 196 / 0.4);
  }

  .footer__links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 36px;
  }
  .footer__links a {
    font-size: var(--fs-label);
    font-weight: 400;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgb(239 226 196 / 0.5);
  }
  .footer__links a:hover {
    color: var(--color-cream);
  }
</style>
