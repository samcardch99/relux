---
import "../styles/global.css";
import { siteGraph } from "../data/schema";
import { counterpartPath, langOfPath } from "../data/copy";

interface Props {
  title?: string;
  description?: string;
  /** Preview photo for links shared on WhatsApp, Instagram, etc. */
  image?: string;
  /** A full-screen view is open on load, so the page underneath must not scroll. */
  locked?: boolean;
  /** Page-specific JSON-LD, added after the business block every page carries. */
  jsonLd?: object[];
  /** Keep the page out of search results (the 404). */
  noindex?: boolean;
}

const {
  title = "Kitchen Remodeling & Custom Cabinets in Miami | RE-LUX Construction",
  description = "Interior remodeling and custom woodwork for homes and businesses across Miami. Kitchens, closets, bathrooms and complete interiors, designed and built by our own team.",
  image = "/assets/liz-1.webp",
  locked = false,
  jsonLd = [],
  noindex = false,
} = Astro.props;

const url = new URL(Astro.url.pathname, Astro.site);
const lang = langOfPath(Astro.url.pathname);
/** Both language versions of this page, for search engines (none on the 404). */
const other = noindex ? null : counterpartPath(Astro.url.pathname);
const alternates = other
  ? { [lang]: url.href, [lang === "es" ? "en" : "es"]: new URL(other, Astro.site).href }
  : null;
/** Google Analytics 4, only once its measurement ID is set (secret PUBLIC_GA_ID
 *  in GitHub, passed to the build by publish.yml). Events: see site.ts. */
const gaId = import.meta.env.PUBLIC_GA_ID;
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={lang === "es" ? "es_US" : "en_US"} />
    {
      alternates && (
        <>
          <link rel="alternate" hreflang="en" href={alternates.en} />
          <link rel="alternate" hreflang="es" href={alternates.es} />
          <link rel="alternate" hreflang="x-default" href={alternates.en} />
        </>
      )
    }
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}
    <meta name="theme-color" content="#060505" />
    {[siteGraph, ...jsonLd].map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}

    <link
      rel="preload"
      href="/fonts/montserrat-latin-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Scales the whole page so the 1512px design keeps its proportions at any
        desktop width — inline and synchronous so it lands before first paint. */}
    <script is:inline>
      (function () {
        var DESIGN = 1512; // 14" MacBook Pro — the reference canvas
        var BREAK = 1081; // below this the responsive layout takes over
        var FLOOR = 0.85; // scaling past this makes 10px labels unreadable
        var root = document.documentElement;
        function apply() {
          var w = root.clientWidth || window.innerWidth;
          var z = w >= BREAK ? Math.max(FLOOR, w / DESIGN) : 1;
          root.style.setProperty("--zoom", z);
          root.style.zoom = z === 1 ? "" : z;
        }
        apply();
        window.addEventListener("resize", apply, { passive: true });
      })();
    </script>
    {
      gaId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () {
              dataLayer.push(arguments);
            };
            gtag("js", new Date());
            gtag("config", gaId);
          </script>
        </>
      )
    }
  </head>
  <body class:list={{ "is-locked": locked }}>
    <slot />
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
